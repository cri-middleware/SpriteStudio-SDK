include "../type_base.fbs";

namespace ss.ssfb2;

// --------------------------------------------------------------------- [Data: Animation]
table Catalog {
    table_id_parts_null:[ushort];
    table_id_parts_normal:[ushort];
    table_id_parts_instance:[ushort];
    table_id_parts_effect:[ushort];
    table_id_parts_mask:[ushort];
    table_id_parts_joint:[ushort];
    table_id_parts_bone:[ushort];
    table_id_parts_move_node:[ushort];
    table_id_parts_constraint:[ushort];
    table_id_parts_bone_point:[ushort];
    table_id_parts_mesh:[ushort];
    table_id_parts_transform_constraint:[ushort];
    table_id_parts_camera:[ushort];
    table_id_parts_audio:[ushort];
    table_id_parts_shape:[ushort];
    table_id_parts_text:[ushort];
    table_id_parts_nine_slice:[ushort];
}

table CodeValueContainer {
    table_code:[int];
}

table ContainerStatus {
    type_pack:ss.basetype.KindTypePack;
    table_code_value:[CodeValueContainer];
//    table_value:[int];
    table_value:[ss.basetype.FlagBitStatusAnimationAttribute];
    table_accessory:[float];
}

table ContainerCell {
    type_pack:ss.basetype.KindTypePack;
    table_code_value:[CodeValueContainer];
    table_value:[ss.basetype.AnimationAttributeCell];
    table_accessory:[float];
}

table ContainerInt {
    type_pack:ss.basetype.KindTypePack;
    table_code_value:[CodeValueContainer];
    table_value:[int];
    table_accessory:[float];
}

table ContainerFloat {
    type_pack:ss.basetype.KindTypePack;
    table_code_value:[CodeValueContainer];
    table_value:[float];
    table_accessory:[float];
}

table ContainerVector2 {
    type_pack:ss.basetype.KindTypePack;
    table_code_value:[CodeValueContainer];
    table_value:[ss.basetype.Vector2];
    table_accessory:[float];
}

table ContainerVector3 {
    type_pack:ss.basetype.KindTypePack;
    table_code_value:[CodeValueContainer];
    table_value:[ss.basetype.Vector3];
    table_accessory:[float];
}

table ContainerPartsColor {
    type_pack:ss.basetype.KindTypePack;
    table_code_value:[CodeValueContainer];
    table_value:[ss.basetype.AnimationAttributePartsColor];
    table_accessory:[float];
}

table ContainerVertexCorrection {
    type_pack:ss.basetype.KindTypePack;
    table_code_value:[CodeValueContainer];
    table_value:[ss.basetype.AnimationAttributeVertexCorrection];
    table_accessory:[float];
}

table ContainerSkew {
    type_pack:ss.basetype.KindTypePack;
    table_code_value:[CodeValueContainer];
    table_value:[ss.basetype.AnimationAttributeSkew];
    table_accessory:[float];
}

table ContainerUserData {
    type_pack:ss.basetype.KindTypePack;
    table_code_value:[CodeValueContainer];
    table_value:[ss.basetype.AnimationAttributeUserData];
    table_accessory:[float];
}

table ContainerInstance {
    type_pack:ss.basetype.KindTypePack;
    table_code_value:[CodeValueContainer];
    table_value:[ss.basetype.AnimationAttributeInstance];
    table_accessory:[float];
}

table ContainerEffect {
    type_pack:ss.basetype.KindTypePack;
    table_code_value:[CodeValueContainer];
    table_value:[ss.basetype.AnimationAttributeEffect];
    table_accessory:[float];
}

table ContainerDeform {
    type_pack:ss.basetype.KindTypePack;
    table_code_value:[CodeValueContainer];
    table_value:[ss.basetype.AnimationAttributeDeform];
    table_accessory:[float];

    count_vertex_mesh:int;
    table_index_vertex:[int];
}

table ContainerShader {
    type_pack:ss.basetype.KindTypePack;
    table_code_value:[CodeValueContainer];
    table_value:[ss.basetype.AnimationAttributeShader];
    table_accessory:[float];
}

table ContainerSignal {
    type_pack:ss.basetype.KindTypePack;
    table_code_value:[CodeValueContainer];
    table_value:[ss.basetype.AnimationAttributeSignal];
    table_accessory:[float];
}

table ContainerAudio {
    type_pack:ss.basetype.KindTypePack;
    table_code_value:[CodeValueContainer];
    table_value:[ss.basetype.AnimationAttributeAudio];
    table_accessory:[float];
}

table ContainerChangeTexture {
    type_pack:ss.basetype.KindTypePack;
    table_code_value:[CodeValueContainer];
    table_value:[ss.basetype.AnimationAttributeChangeTexture];
    table_accessory:[float];
}

table DataAnimationParts {
    status_parts:ss.basetype.FlagBitStatusDataAnimationParts;

    status:ContainerStatus;
    cell:ContainerCell;
    position:ContainerVector3;
    rotation:ContainerVector3;
    scaling:ContainerVector2;
    scaling_local:ContainerVector2;
    rate_opacity:ContainerFloat;
    priority:ContainerInt;
    parts_color:ContainerPartsColor;
    vertex_correction:ContainerVertexCorrection;
    skew:ContainerSkew;
    offset_pivot:ContainerVector2;
    position_anchor:ContainerVector2;
    size_force:ContainerVector2;
    position_texture:ContainerVector2;
    rotation_texture:ContainerFloat;
    scaling_texture:ContainerVector2;
    radius_collision:ContainerFloat;
    user_data:ContainerUserData;
    instance:ContainerInstance;
    effect:ContainerEffect;
    deform:ContainerDeform;
    shader:ContainerShader;
    signal:ContainerSignal;
    audio:ContainerAudio;
    change_texture:ContainerChangeTexture;
}

table LibraryDataAnimation {
    name:string;
    frame_per_second:int;
    count_frame:int;

    size_canvas_x:int;
    size_canvas_y:int;

    frame_valid_start:int;
    frame_valid_end:int;
    count_frame_valid:int;

    depth_ik:int;
    mode_sort :ss.basetype. KindModeSort;

    table_label:[ss.basetype.Label];
    table_parts:[DataAnimationParts];
}

// --------------------------------------------------------------------- [Data: Effect]
table DataEffectParts {
    name:string;

    id:ushort;
    id_parent:ushort;
    table_id_child:[int];

//  feature:KindFeaturePartsDataEffect;
    feature:ushort;
    index_emitter:ushort;
}

table DataEffectEmitter {
//  flag_data:ss.basetype.FlagBitEmitterDataEffect;
    flag_data:uint;

//  operation_blend_target:ss.basetype.KindOperationBlendEffect;
    operation_blend_target:uint;

    index_cell_map:ushort;
    index_cell:ushort;

    angle:ss.basetype.RangeFloat;

    gravity_directional:ss.basetype.Vector2;
    gravity_point_position:ss.basetype.Vector2;
    gravity_point_power:float;

    position:ss.basetype.RangeVector2;

    rotation:ss.basetype.RangeFloat;
    rotation_fluctuation:ss.basetype.RangeFloat;
    rotation_fluctuation_rate:float;
    rotation_fluctuation_rate_time:float;

    rate_tangential_acceleration:ss.basetype.RangeFloat;

    scale_start:ss.basetype.RangeVector2;
    scale_rate_start:ss.basetype.RangeFloat;

    scale_end:ss.basetype.RangeVector2;
    scale_rate_end:ss.basetype.RangeFloat;

    delay:int;

    color_vertex:ss.basetype.RangeColor;
    color_vertex_fluctuation:ss.basetype.RangeColor;

    alpha_fade_start:float;
    alpha_fade_end:float;

    speed:ss.basetype.RangeFloat;
    speed_fluctuation:ss.basetype.RangeFloat;

    turn_direction_fluctuation:float;

    seed_random:long;

    duration_emitter:int;
    interval:int;
    duration_particle:ss.basetype.RangeFloat;

    count_particle_max:int;
    count_particle_emit:int;

    count_parts_maximum:int;
    table_pattern_emit:[ss.basetype.PatternEmit];
    table_pattern_offset:[int];
    table_seed_particle:[long];
}
