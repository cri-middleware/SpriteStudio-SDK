namespace ss.basetype;

// --------------------------------------------------------------------- [DataーVersion]

enum DataExtendInformationFileFlagBitStatus:ushort {
    CLEAR = 0x0000,

    USED_FROM_DATA = 0x0001,

    IS_DATA = 0x4000,
//  (Don't use) = 0x8000,
}

table DataExtendInformationFile {
    status:DataExtendInformationFileFlagBitStatus;
    name:string;
}

// --------------------------------------------------------------------- [Base-Types: Tuple]
table Vector2 {
    x:float;
    y:float;
}

table Vector3 {
    x:float;
    y:float;
    z:float;
}

table Rect {
    x_min:float;
    y_min:float;
    x_max:float;
    y_max:float;
}

table Color32 {
    r:ubyte;
    g:ubyte;
    b:ubyte;
    a:ubyte;
}

table Color {
    r:float;
    g:float;
    b:float;
    a:float;
}

// --------------------------------------------------------------------- [Data-Types: File]
enum KindDataFile:ubyte {
    PROJECT = 0x00,
    CELLMAP = 0x01,
    ANIMATION = 0x02,
    EFFECT = 0x03,
    SEQUENCE = 0x04,
    SOUND = 0x05,
    FONT_BITMAP = 0x06,
    /* Max:0x0f */
}

// --------------------------------------------------------------------- [Data-Types: Cells]
enum LibraryDataCellMapFlagBitStatus:ushort {
    CLEAR = 0x0000,

    TEXTURE_CONVERT_PMA = 0x0001,
    BLEND_IMAGE_PMA = 0x0002,
    CORRECT_SHADER_PMA = 0x0004,

//  (Don't use) = 0x8000,
}

table DataMeshCell {
    table_coordinate:[Vector2];
    table_index_vertex:[ushort];
}
table Cell {
    name:string;
    rectangle:Rect;
    pivot:Vector2;
    rotate:float;
    size_untrimmed:Vector2;
    mesh:DataMeshCell;
}

table LibraryDataCellMap {
    name:string;
    size_original:Vector2;
    filter:short;
    wrap:short;
    status:LibraryDataCellMapFlagBitStatus;
    table_cell:[Cell];
}

// --------------------------------------------------------------------- [Data-Types: Animation]
enum KindFeatureParts:ubyte {
    ROOT = 0,               // Root-Parts (Subspecies of "NULL"-Parts)
    NULL_PARTS,
    NORMAL,

    INSTANCE,
    EFFECT,

    MASK,

    JOINT,
    BONE,
    MOVENODE,
    CONSTRAINT,
    BONEPOINT,
    MESH,

    TRANSFORM_CONSTRAINT,
    CAMERA,

    AUDIO,
    SHAPE,
    TEXT,
    NINE_SLICE,

    TERMINATOR,
}

enum KindOperationBlend:byte {
//  TERMINATOR_TABLEMATERIAL = TERMINATOR - INITIATOR,
//  TERMINATOR_PARTSCOLOR = MUL_NA,
//  INITIATOR = MASK_PRE,

    MASKPRE = -2,
    MASK = -1,
//  NON = -1,

    MIX = 0,
    ADD,
    SUB,
    MUL,

    MULNA,
    SCR,
    EXC,
    INV,

    TERMINATOR,
}

enum KindModeSort:ubyte {
    PRIORITY = 0,
    POSITIONZ,
}

enum KindFormColorLabel:ubyte {
    NON = 0,

    RED,
    ORANGE,
    YELLOW,
    GREEN,
    BLUE,
    VIOLET,
    GRAY,

    TERMINATOR,
//  CUSTOM = TERMINATOR
}

enum KindStatuss:int{
    CLEAR = 0,

    MODE_MASK = 0x00000001,
    TEXT_BITMAP = 0x00000010,
    TEXT_SMOOTH_TEXTURE = 0x00000020,
    MODE_TILE_NINE_SLICE = 0x00000100,
 }

enum KindVertex:ubyte {
// MEMO: CW (Clockwise) sequence.
    LU = 0,
    RU,
    RD,
    LD,
    C, // Muust be the last numbered. (Used only Runtime)

// MEMO: Follows are used only Runtime. (Labels to identify length of arrays and count of "for"-loops)
    TERMINATOR,

    // MEMO: Following definitions may cause errors depending on programming-language, so define additionally in runtime-side.
//  TERMINATOR4 = 5,      // = TERMINATOR:for "Normal(Sprite)"
//  TERMINATOR3 = 3,      // = LD (== C - 1):for "Mesh"
//  TERMINATOR2 = 4,      // = C:for "Effect"
}

enum KindCollision:ubyte {
    NON = 0,
    SQUARE,
    AABB,
    CIRCLE,
    CIRCLE_SCALE_MINIMUM,
    CIRCLE_SCALE_MAXIMUM,
}

enum KindShape:byte {
    NON = -1,
    RECTANGLE = 0,
}

enum KindAnchorText:byte {
    NON = -1,
    LU = 0,
    CU = 1,
    RU = 2,
    _RESERVE_U = 3,
    LC = 4,
    CC = 5,
    RC = 6,
    _RESERVE_C = 7,
    LD = 8,
    CD = 9,
    RD = 10,
    _RESERVE_D = 11,
}

enum KindTypePack:byte {
    STANDARD_UNCOMPRESSED = 0, // [Obsolete] Standard-Uncompressed (Plain Array)
    STANDARD_CPE, // [Obsolete] Standard-Compressed (Changing-Point Extracting)
    CPE_FLYWEIGHT, // [Obsolete] CPE & GoF-Flyweight (Commonized CPE's dictionary)
    CPE_INTERPOLATE, // CPE & Interpolate (Linear,Acceleration and Deceleration: Interpolate / Other: CPE)

    TERMINATOR,
}

enum FlagBitStatusDataAnimationParts:uint {
    CLEAR = 0x00000000,

    NO_AUDIO = 0x00004000,
    NO_SIGNAL = 0x00008000,

    NO_EFFECT = 0x00010000,
    NO_INSTANCE = 0x00020000,
    NO_PARTSCOLOR = 0x00040000,
    NO_USERDATA = 0x00080000,

    NO_TRANSFORMATION_TEXTURE = 0x00100000,
    NO_SCALING = 0x00200000,
    NO_ROTATION = 0x00400000,
    NO_POSITION = 0x00800000,

    NO_TMASKING = 0x08000000,
    MODE_SKEW = 0x01000000,

    HIDE_FULL = 0x10000000,
    NOT_USED = 0x20000000,
    VALID = 0x40000000,
}

enum FlagUse0DataSetup:uint {
    CLEAR = 0x00000000,

    HAS_STATUS = 0x00000001,
    HAS_CELL = 0x00000002,
    HAS_POSITION_X = 0x00000004,
    HAS_POSITION_Y = 0x00000008,
    HAS_POSITION_Z = 0x00000010,
    HAS_ROTATION_X = 0x00000020,
    HAS_ROTATION_Y = 0x00000040,
    HAS_ROTATION_Z = 0x00000080,
    HAS_SCALING_X = 0x00000100,
    HAS_SCALING_Y = 0x00000200,
    HAS_SCALINGLOCAL_X = 0x00000400,
    HAS_SCALINGLOCAL_Y = 0x00000800,
    HAS_RATEOPACITY = 0x00001000,
    HAS_RATEOPACITYLOCAL = 0x00002000,
    HAS_POWERMASK = 0x00004000,
    HAS_PRIORITY = 0x00008000,
    HAS_PARTSCOLOR = 0x00010000,
    HAS_VERTEXCORRECTION = 0x00020000,
    HAS_SKEW = 0x00040000,
    HAS_OFFSETPIVOT_X = 0x00080000,
    HAS_OFFSETPIVOT_Y = 0x00100000,
    HAS_POSITIONANCHOR_X = 0x00200000,
    HAS_POSITIONANCHOR_Y = 0x00400000,
    HAS_SIZEFORCE_X = 0x00800000,
    HAS_SIZEFORCE_Y = 0x01000000,
    HAS_POSITIONTEXTURE_X = 0x02000000,
    HAS_POSITIONTEXTURE_Y = 0x04000000,
    HAS_ROTATIONTEXTURE = 0x08000000,
}

enum FlagUse1DataSetup:uint {
    CLEAR = 0x00000000,

    HAS_SCALINGTEXTURE_X = 0x00000001,
    HAS_SCALINGTEXTURE_Y = 0x00000002,
    HAS_RADIUSCOLLISION = 0x00000004,
    HAS_USERDATA  = 0x00000008,
    HAS_INSTANCE = 0x00000010,
    HAS_EFFECT = 0x00000020,
    HAS_DEFORM = 0x00000040,
    HAS_SHADER = 0x00000080,
    HAS_SIGNAL = 0x00000100,
    HAS_AUDIO  = 0x00000200,
    HAS_CHANGETEXTURE = 0x00000400,
}

enum FlagBitStatusAnimationAttribute:int {
    CLEAR = 0x00000000,
    ID_PARTS_NEXTDRAW = 0x00000fff,
    ID_PARTS_NEXTPREDRAW = 0x00fff000,
    FLIP_TEXTURE_Y = 0x01000000,
    FLIP_TEXTURE_X = 0x02000000,
    FLIP_Y = 0x04000000,
    FLIP_X = 0x08000000,
    HIDE   = 0x20000000,
    VALID  = 0x40000000,

    MASK = 0x6fffffff,      // (VALID | HIDE | FLIP_X | FLIP_Y | FLIP_TEXTURE_X | FLIP_TEXTURE_Y | ID_PARTS_NEXTPREDRAW | ID_PARTS_NEXTDRAW),
    INITIAL = 0x40ffffff, //(VALID | ID_PARTS_NEXTDRAW | ID_PARTS_NEXTPREDRAW),
}

enum FlagBitUserData:uint {
    CLEAR = 0x00000000,
    NUMBER = 0x00000001,
    RECTANGLE = 0x00000002,
    COORDINATE = 0x00000004,
    TEXT = 0x00000008,

    VALID = 0x40000000,
}

table Label {
    name:string;
    frame:ushort;
}

table ColorLabel {
    form:KindFormColorLabel;
    color:Color32;
}

table BindMeshBone {
    index:ushort;
    weight:float;
    coordinate_offset:Vector3;
}
table BindMeshVertex {
    table_bone:[BindMeshBone];
}
table BindMesh {
    count_vertex:int;
    table_vertex:[BindMeshVertex];
    table_rate_uv:[Vector2];
    table_index_vertex:[uint16];

    count_vertex_deform:int;
}

table AnimationAttributeCell {
    index_cell_map:int;
    index_cell:int;
}

table AnimationAttributePartsColor {
    bound:short;
    operation:short;
    vertex_color:[Color];
    rate_alpha:[float];
}

table AnimationAttributeVertexCorrection {
    coordinate:[Vector2];
}

table AnimationAttributeSkew {
    x:float;
    y:float;
}

table AnimationAttributeUserData {
    flags:FlagBitUserData;
    number_int:int;
    rectangle:Rect;
    coordinate:Vector2;
    text:string;
}

table AnimationAttributeSignalCommandParameter {
    id:int;
    type:int;
    data:string;
}
table AnimationAttributeSignalCommand {
    flags:int;
    id:int;
    note:string;
    table_parameter:[AnimationAttributeSignalCommandParameter];
}
table AnimationAttributeSignal {
    table_command:[AnimationAttributeSignalCommand];
}

table AnimationAttributeInstance {
    flags:int;
    play_count:int;
    rate_time:float;
    offset_start:int;
    offset_end:int;
    label_start:string;
    label_end:string;
}

table AnimationAttributeEffect {
    flags:int;
    frame_start:int;
    rate_time:float;
}

table AnimationAttributeDeform {
    table_coordinate:[Vector2];
}

table AnimationAttributeShader {
    id:string;
    parameter:[float];
}

table AnimationAttributeAudio {
    id:short;
    index:short;
    count_play:short;
}

table AnimationAttributeChangeTexture {
    index_texture:short;
}

table DataModelParts {
    name:string;
    id:int;
    id_parent:int;
    table_id_children:[int];

    feature:KindFeatureParts;

    count_mesh:int;
    mesh:BindMesh;

    label_color:ColorLabel;

    operation_blend_target:KindOperationBlend;

    shape_collision:KindCollision;
    size_collision:float;

    index_animation_pack_under_control:ushort;
    index_effect_under_control:ushort;
    name_animation_under_control:string;

    size_font_text:float;
    space_text:float;
    size_x_text:int;
    size_y_text:int;
    name_family_font_text:string;
    index_bitmap_font_text:int;
    text:string;
    anchor_text:KindAnchorText;

    shape:KindShape;

    margin_l_nineslice:int;
    margin_r_nineslice:int;
    margin_u_nineslice:int;
    margin_d_nineslice:int;

    status:KindStatuss;
}

table DataSetup {
    flag_use0:FlagUse0DataSetup;
    flag_use1:FlagUse1DataSetup;

//    status:int;
    status:FlagBitStatusAnimationAttribute;
    cell:AnimationAttributeCell;
    position_x:float;
    position_y:float;
    position_z:float;
    rotation_x:float;
    rotation_y:float;
    rotation_z:float;
    scaling_x:float;
    scaling_y:float;
    scalinglocal_x:float;
    scalinglocal_y:float;
    rateopacity:float;
    rateopacitylocal:float;
    powermask:float;
    priority:int;
    partscolor:AnimationAttributePartsColor;
    vertexcorrection:AnimationAttributeVertexCorrection;
    skew:AnimationAttributeSkew;
    offsetpivot_x:float;
    offsetpivot_y:float;
    position_anchor_x:float;
    position_anchor_y:float;
    size_force_x:float;
    size_force_y:float;
    position_texture_x:float;
    position_texture_y:float;
    rotation_texture:float;
    scaling_texture_x:float;
    scaling_texture_y:float;
    radius_collision:float;
    user_data:AnimationAttributeUserData;
    instance:AnimationAttributeInstance;
    effect:AnimationAttributeEffect;
    deform:AnimationAttributeDeform;
    deform_tableindex:[int];
    deform_countvertex:int;
    shader:AnimationAttributeShader;
    signal:AnimationAttributeSignal;
    audio:AnimationAttributeAudio;
    change_texture:AnimationAttributeChangeTexture;
}

// --------------------------------------------------------------------- [Data-Types: Effect]
enum KindOperationBlendEffect:byte {
//  TERMINATOR_TABLEMATERIAL = TERMINATOR - INITIATOR,
//  INITIATOR = MIX,

    NON = -1,
    MIX = 0,
    ADD,
    TERMINATOR,
}

enum DataEffectFlagBit:uint {
    CLEAR = 0x00000000,

    SEED_RANDOM_LOCK = 0x00000001,
}

enum KindFeaturePartsDataEffect:ubyte {
    ROOT = 0,
    EMITTER,
    PARTICLE,

    TERMINATOR,
}

enum FlagBitEmitterDataEffect:uint {
    CLEAR = 0x00000000,

    BASIC = 0x00000001, /* (Reserved) */
    TANGENTIAL_ACCELATION = 0x00000002,
    TURN_DIRECTION = 0x00000004,
    SEED_RANDOM = 0x00000008,
    DELAY = 0x00000010,

    POSITION = 0x00000100,
    POSITION_FLUCTUATION = 0x00000200, /* (Reserved) */
    ROTATION = 0x00000400,
    ROTATION_FLUCTUATION = 0x00000800,
    SCALE_START = 0x00001000,
    SCALE_END = 0x00002000,

    SPEED = 0x00010000, /* (Reserved) */
    SPEED_FLUCTUATION = 0x00020000,
    GRAVITY_DIRECTION = 0x00040000,
    GRAVITY_POINT = 0x00080000,

    COLOR_VERTEX = 0x00100000,
    COLOR_VERTEX_FLUCTUATION = 0x00200000,
    FADE_ALPHA = 0x00400000,

    EMIT_INFINITE = 0x01000000,

    MASK_EMITTER = 0x7f000000,
    MASK_PARTICLE = 0x00ffffff,
    MASK_VALID = 0x7fffffff,
}

table RangeFloat {
    main:float;
    sub:float;
}

table RangeVector2 {
    main:Vector2;
    sub:Vector2;
}

table RangeColor {
    main:Color;
    sub:Color;
}

table PatternEmit {
    index_generate:int;
    duration:int;
    cycle:int;
}

// --------------------------------------------------------------------- [Data-Types: Sequence]
table DataSequenceDetails {
    ref_anime_pack:string;
    ref_anime:string;
    repeat_count:int;
}

table DataSequence {
    name:string;
    index:int;
    type:int;
    value_list:[DataSequenceDetails];
}

// --------------------------------------------------------------------- [Data-Types: Sound-List]
table LibraryDataSound {
    name:string;
    path:string;
    time_total:float;
}

// --------------------------------------------------------------------- [Data-Types: Font]
table LibraryDataFontGryphBitmap {
    id:uint;
    atlas:Rect;
    offset:Vector2;
    width_advance:float;
    text:string;
    page:byte;
    channel:byte;
}
