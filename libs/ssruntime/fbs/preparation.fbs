namespace ss.runtime;

struct Vec2 {
  x: float;
  y: float;
}

struct Vec3 {
  x: float;
  y: float;
  z: float;
}

struct U8Rect {
  a: ubyte;
  r: ubyte;
  g: ubyte;
  b: ubyte;
}

struct Rect {
  x1: float;
  y1: float;
  x2: float;
  y2: float;
}

table IntValueEntry {
  value: int;
}

// initial_data

table PartAttributeCell {
 map_id: int; // hash or name
 name: string;
}

table  SsAttributePartsColorKeyValueColor {
  rgba: U8Rect;
  rate: float;
}

enum BlendType : ubyte {
  Mix,
  Mul,
  Add,
  Sub,
  Mulalpha,
  Screen,
  Exclusion,
  Invert,
}

table PartAttributePartsColor {
  blend_type: BlendType;

  lt: SsAttributePartsColorKeyValueColor;
  rt: SsAttributePartsColorKeyValueColor;
  lb: SsAttributePartsColorKeyValueColor;
  rb: SsAttributePartsColorKeyValueColor;
}

table PartAttributeVertex {
  lt: Vec2;
  rt: Vec2;
  lb: Vec2;
  rb: Vec2;
}

table PartAttributeInstance {
  pingpong: bool;
  independent: bool;
  loop_num: int;
  start_label: string;
  start_offset: int;
  end_label: string;
  end_offset: int;
  speed: float;
}

table PartAttributeEffect {
  cur_keyframe: int;
  start_time: int;
  speed: float;
  loopflag: int;
}

table PartAttributeDeform {
  coordinate: [Vec2];
  index: [short];
}

table PartAttributeShader {
  id: string;
  param0: float;
  param1: float;
  param2: float;
  param3: float;
  param4: float;
  param5: float;
  param6: float;
  param7: float;
  map0_id: int;
  map0_name: string;
  map1_id: int;
  map1_name: string;
}

table PartAttributeUserData {
  integer: IntValueEntry;
  rect: Rect;
  point: Vec2;
  str: string;
}

enum SignalCommandParamType: ubyte {
  Index,
  Integer,
  Floating,
  None,
}

table SignalCommandParam {
  param_id: string;
  type: SignalCommandParamType;
  value: float;
}

table PartAttributeSignal {
  active: bool;
  command_id: string;
  params: [SignalCommandParam];
}

table PartAttributeAudio {
  sound_list_id: int;
  sound_name: string;
  loop_num: int;
}

table PartAttributes {
  cell: PartAttributeCell;
  position: Vec3;
  rotation: Vec3;
  scale: Vec2;
  local_scale: Vec2;
  opacity: short;
  localopacity: short;
  priority: short;
  flip_v: bool;
  flip_h: bool;
  hide: bool;
  parts_color: PartAttributePartsColor;
  shader: PartAttributeShader;
  vertex: PartAttributeVertex;
  pivot: Vec2;
  size: Vec2;
  uv_move: Vec3;
  uv_scale: Vec2;
  bounding_radius: float;
  mask: float;
  skew: Vec2;
  deform: PartAttributeDeform;

  texture: int;
}

// part_mesh_data

table PartMeshData {
  part_index: ushort;

  uv: [float];
  indices: [int];
  count_coordinate_mesh: int;
  index_coordinate_deform: [int];
}

// events

table EventUserData {
  part_index: ushort (key);

  value: PartAttributeUserData;
}

table EventSignal {
  part_index: ushort (key);

  value: PartAttributeSignal;
}

table EventAudio {
  part_index: ushort (key);

  value: PartAttributeAudio;
}

table EventInstance {
  part_index: ushort (key);

  value: PartAttributeInstance;
}

table EventEffect {
  part_index: ushort (key);

  value: PartAttributeEffect;
}

table EventsPerFrame {
  frame_index: ushort (key);

  user: [EventUserData];
  signal: [EventSignal];
  audio: [EventAudio];
  instance: [EventInstance];
  effect: [EventEffect];
}

// lable_data

table Label {
  name: string (key);
  time: int;
}

table AnimPrepData {
  initial_data: [PartAttributes];
  part_mesh_data: [PartMeshData];

  events: [EventsPerFrame];

  label_data: [Label];

  start_frames: short;
  end_frames: short;
  total_frames: short;
  fps: short;

  canvas: Rect;
}

root_type AnimPrepData;
