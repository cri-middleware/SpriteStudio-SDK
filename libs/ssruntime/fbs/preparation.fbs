namespace ss.runtime;

table PartAttributes {
  cell_index: short;
  position_x: float;
  position_y: float;
  position_z: float;
  rotation_x: float;
  rotation_y: float;
  rotation_z: float;
  scale_x: float;
  scale_y: float;
  localscale_x: float;
  localscale_y: float;
  opacity: short;
  localopacity: short;
  priority: short;
  flip_v: bool;
  flip_h: bool;
  hide: bool;
  parts_color: PartAttributePartsColor;
  shader: PartAttributeShader;
  vertex: PartAttributeVertex;
  pivot: Vec2;
  size: Vec2;
  uv_move: Vec3;
  uv_scale: Vec2;
  bounding_radius: float;
  mask: float;
  instance: PartAttributeInstance;
  effect: PartAttributeEffect;
  skew: Vec2;
  deform: PartAttributeDeform;

  texture: string;
}

table Preparation {
  initial_data: [PartAttributes];

  events: [EventsPerFrame];

  label_data: [Label];

  meshs_data_uv: [MeshDataUV];
  meshs_data_indices: [MeshDataIndices];

  start_frames: short;
  end_frames: short;
  total_frames: short;
  fps: short;

  canvas: Rect;
}

root_type Preparation;
