namespace ss.runtime;

struct Vec2 {
  x: float;
  y: float;
}

struct U8Rect {
  a: ubyte;
  r: ubyte;
  g: ubyte;
  b: ubyte;
}

struct Rect {
  x1: float;
  y1: float;
  x2: float;
  y2: float;
}

table IntValueEntry {
  value: int;
}

// initial_data

table PartAttributeCell {
 map_id: int; // hash or name
 name: string;
}

table  SsAttributePartColorKeyValueColor {
  rgba: U8Rect;
  rate: float;
}

enum BlendType : ubyte {
  Mix,
  Mul,
  Add,
  Sub,
  Mulalpha,
  Screen,
  Exclusion,
  Invert,
}

table PartAttributePartColor {
  blend_type: BlendType;

  lt: SsAttributePartColorKeyValueColor;
  rt: SsAttributePartColorKeyValueColor;
  lb: SsAttributePartColorKeyValueColor;
  rb: SsAttributePartColorKeyValueColor;
}

table PartAttributeVertex {
  lt: Vec2;
  rt: Vec2;
  lb: Vec2;
  rb: Vec2;
}

table PartAttributeInstance {
  pingpong: bool;
  independent: bool;
  loop_num: int;
  start_label: string;
  start_offset: int;
  end_label: string;
  end_offset: int;
  speed: float;
}

table PartAttributeEffect {
  cur_keyframe: int;
  start_time: int;
  speed: float;
  loopflag: int;
}

table PartAttributeDeform {
  coordinate: [Vec2];
  index: [short];
}

table PartAttributeShader {
  id: string;
  param0: float;
  param1: float;
  param2: float;
  param3: float;
  param4: float;
  param5: float;
  param6: float;
  param7: float;
  map0_id: int;
  map0_name: string;
  map1_id: int;
  map1_name: string;
}

table PartAttributeUserData {
  integer: IntValueEntry;
  rect: Rect;
  point: Vec2;
  str: string;
}

enum SignalCommandParamType: ubyte {
  Index,
  Integer,
  Floating,
  None,
}

table SignalCommandParam {
  param_id: string;
  type: SignalCommandParamType;
  value: float;
}

table PartAttributeSignal {
  active: bool;
  command_id: string;
  params: [SignalCommandParam];
}

table PartAttributeAudio {
  sound_list_id: int;
  sound_name: string;
  loop_num: int;
}

table PartAttributes {
  cell: PartAttributeCell;
  position_x: float = 0.0;
  position_y: float = 0.0;
  position_z: float = 0.0;
  rotation_x: float = 0.0;
  rotation_y: float = 0.0;
  rotation_z: float = 0.0;
  scale_x: float = 1.0;
  scale_y: float = 1.0;
  local_scale_x: float = 1.0;
  local_scale_y: float = 1.0;
  opacity: float = 1.0;
  localopacity: float = 1.0;
  priority: int = 0;
  flip_v: bool = false;
  flip_h: bool = false;
  hide: bool = false;
  parts_color: PartAttributePartColor;
  shader: PartAttributeShader;
  vertex: PartAttributeVertex;
  pivot_x: float = 0.0;
  pivot_y: float = 0.0;
  anchor_x: float = 0.0;
  anchor_y: float = 0.0;
  size_x: float = 1.0;
  size_y: float = 1.0;
  img_flip_h: bool = false;
  img_flip_v: bool = false;
  uv_move_x: float = 0.0;
  uv_move_y: float = 0.0;
  uv_move_z: float = 0.0;
  uv_scale_x: float = 1.0;
  uv_scale_y: float = 1.0;
  bounding_radius: float = 0.0;
  mask: float = 0.0;
  skew_x: float = 0.0;
  skew_y: float = 0.0;
  deform: PartAttributeDeform;
  texture: int = -1;
}

// part_mesh_data

table PartMeshData {
  part_index: ushort;

  uv: [float];
  indices: [int];
  count_coordinate_mesh: int;
  index_coordinate_deform: [int];
}

// events

table EventUserData {
  part_index: ushort (key);

  value: PartAttributeUserData;
}

table EventSignal {
  part_index: ushort (key);

  value: PartAttributeSignal;
}

table EventAudio {
  part_index: ushort (key);

  value: PartAttributeAudio;
}

table EventInstance {
  part_index: ushort (key);

  value: PartAttributeInstance;
}

table EventEffect {
  part_index: ushort (key);

  value: PartAttributeEffect;
}

table EventsPerFrame {
  frame_index: ushort (key);

  users: [EventUserData];
  signals: [EventSignal];
  audios: [EventAudio];
  instances: [EventInstance];
  effects: [EventEffect];
}

// lable_data

table Label {
  name: string (key);
  time: int;
}

table AnimPrepData {
  parts_initial_attributes: [PartAttributes];
  parts_mesh_data: [PartMeshData];

  events: [EventsPerFrame];

  labels: [Label];

  start_frame: short;
  end_frame: short;
  total_frame: short;
  fps: short;

  canvas: Rect;
}

root_type AnimPrepData;
