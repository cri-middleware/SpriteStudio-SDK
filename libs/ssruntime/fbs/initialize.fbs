namespace ss.runtime;

struct Vec2 {
  x: float;
  y: float;
}

struct Rect {
  x1: float;
  y1: float;
  x2: float;
  y2: float;
}

table IntValueEntry {
  value: int;
}

table FloatValueEntry {
  value: float;
}

table Vec2ValueEntry {
  value: Vec2;
}

table RectValueEntry {
  value: Rect;
}


enum BoundsType: ubyte {
  None,
  Quad,
  Aabb,
  Circle,
  CircleSmin,
  CircleSmax,
}

enum BlendType: ubyte {
  Mix,
  Mul,
  Add,
  Sub,
  Mulalpha,
  Screen,
  Exclusion,
  Invert,
}

enum RenderBlendType: ubyte {
  Mix,
  Add,
}

enum EffectNodeType: ubyte {
  Root,
  Emitter,
  Particle,
}

enum TexWrapMode: ubyte {
  Clamp,
  Repeat,
  Mirror,
}

enum TexFilterMode: ubyte {
  Nearest,
  Linear,
}

// parts

table PartTypeNone {
  // nothing
}

enum ShapeType: ubyte {
  Unknown,
  Triangle,
  Rectangle,
  Arrow,
  Star,
}

table PartTypeShape {
  shape_type: ShapeType;
  shape_mask: bool;
}

enum TextAnchor: ubyte {
  NO = 0xFF,

  LT = 0x00,
  LC = 0x01,
  LB = 0x02,
  CT = 0x10,
  CC = 0x11,
  CB = 0x12,
  RT = 0x20,
  RC = 0x21,
  RB = 0x22,
}

table PartTypeText {
  text: string;
  text_bitmap: bool;
  text_family: string;
  text_char_map: string;
  text_size: int;
  text_space: float;
  text_smooth: bool;
  text_mask: bool;
  text_width: int;
  text_height: int;
  e_anchor: TextAnchor;
}

table PartTypeNines {
  nines_margin_l: int;
  nines_margin_r: int;
  nines_margin_t: int;
  nines_margin_b: int;
  nines_fill_mode: int;
  nines_mask: bool;
}

table PartTypeInstance {
  ref_anime: string;
}

table PartTypeEffect {
  ref_effect_name: string;
}

union PartType {
  PartTypeNull: PartTypeNone,
  PartTypeNormal: PartTypeNone,
  PartTypeShape,
  PartTypeText,
  PartTypeNines,
  PartTypeInstance,
  PartTypeArmature: PartTypeNone,
  PartTypeEffect,
  PartTypeMesh: PartTypeNone,
  PartTypeMovenode: PartTypeNone,
  PartTypeConstraint: PartTypeNone,
  PartTypeMask: PartTypeNone,
  PartTypeJoint: PartTypeNone,
  PartTypeBonepoint: PartTypeNone,
  PartTypeTransformConstraint: PartTypeNone,
  PartTypeCamera: PartTypeNone,
  PartTypeAudio: PartTypeNone,
}

table PartData {
  name: string;
  parent_index: short;
  bounds_type: BoundsType;
  blend_type: BlendType;

  part_type: PartType;
}

// cell_map

table Cell {
  name: string;

  rectangle: Rect;
  pivot: Vec2;
  rotated: bool;

  table_coordinate: [Vec2];
  table_index_vertex: [ushort];
}

table CellMap {
  name: string;

  image_path: string;
  size_original: Vec2;

  wrap_mode: TexWrapMode;
  filter_mode: TexFilterMode;

  cells: [Cell];
}

// effect

table EffectParticlePointGravity {
  position: Vec2;
  power: float;
}

table RectAndVec2ValueTable {
  size: Rect;
  scale_factor_value: Vec2; // min, max
}

table EffectParticleElementTransColor {
  color_min_value: uint;
  color_max_value: uint;
}

table EffectParticleElementInitColor {
  color_min_value: uint;
  color_max_value: uint;
}

table EffectParticleElementRotationTrans {
  rotation_factor: float;
  end_life_time_per: float;
}

table EffectParticleElementRotation {
  rotation_value: Vec2; // min, max
  rotation_add_value: Vec2; // min, max
}

table EffectParticleElementBasic {
  priority: int;
  maximum_particle: int;
  attime_create: int;
  interval: int;
  lifetime: int;
  speed_min_value: float;
  speed_max_value: float;
  lifespan_min_value: int;
  lifespan_max_value: int;
  angle: float;
  angle_variance: float;
}

union EffectNodeBehavior {
  EffectParticleElementBasic,
  EffectParticleElementRndSeedChange: IntValueEntry,
  EffectParticleElementDelay: IntValueEntry,
  EffectParticleElementGravity: Vec2ValueEntry,
  EffectParticleElementPosition: RectValueEntry,
  EffectParticleElementRotation,
  EffectParticleElementRotationTrans,
  EffectParticleElementTransSpeed: Vec2ValueEntry,
  EffectParticleElementTangentialAcceleration: Vec2ValueEntry,
  EffectParticleElementInitColor,
  EffectParticleElementTransColor,
  EffectParticleElementAlphaFade: Vec2ValueEntry,
  EffectParticleElementSize: RectAndVec2ValueTable,
  EffectParticleElementTransSize: RectAndVec2ValueTable,
  EffectParticlePointGravity,
  EffectParticleTurnToDirectionEnabled: FloatValueEntry,
  EffectParticleInfiniteEmitEnabled: IntValueEntry,
}

table EffectNodeBehaviorWrapper {
  value: EffectNodeBehavior;
}

table EffectNode {
  index: short;
  parent_index: short;
  effect_node_type_type: EffectNodeType;
  cell_index: short;
  blend_type: RenderBlendType;
  behavior: [EffectNodeBehaviorWrapper];
}

table Effect {
  name: string;
  fps: short;
  is_lock_rand_seed: bool;
  lock_rand_seed: short;
  layout_scale: Vec2;
  effect_node: [EffectNode];
}

// sound_list

table SoundFile {
  name: string;
  time_total: uint;
}

table SoundList {
  name: string;
  table_data:[SoundFile];
}

// font_bitmap

table FontGlyphBitmap {
  id: ushort;
  atlas: Rect;
  offset: Vec2;
  width_advance: float;
  text: string;
  page: byte;
  channel: byte;
}

table FontBitmap {
  name: string;

  name_face: string;
  size: ushort;
  padding_l: ushort;
  padding_r: ushort;
  padding_u: ushort;
  padding_d: ushort;
  base: short;
  height_line: short;
  scale: Vec2;
  spacing: Vec2;
  size_texture_original: Vec2;

  name_texture: [string];
  table_data: [FontGlyphBitmap];
}

table InitData {
  name: string;
  parts: [PartData];

  cellmaps: [CellMap];
  effects: [Effect];
  sound_lists: [SoundList];
  font_bitmaps: [FontBitmap];

  external_instances: [string];
}

root_type InitData;
