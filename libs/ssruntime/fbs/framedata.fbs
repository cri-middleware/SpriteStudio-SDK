namespace ss.runtime;

struct PartAttributeCell {
 map_id: int; // hash or name
 name_hash: uint32; // instead of name: string;
}

struct Vec2 {
  x: float;
  y: float;
}

struct U8Rect {
  a: ubyte;
  r: ubyte;
  g: ubyte;
  b: ubyte;
}

struct  SsAttributePartColorKeyValueColor {
  rgba: U8Rect;
  rate: float;
}

enum BlendType: ubyte {
  Mix,
  Mul,
  Add,
  Sub,
  Mulalpha,
  Screen,
  Exclusion,
  Invert,
}

struct PartAttributePartColor {
  blend_type: BlendType;

  lt: SsAttributePartColorKeyValueColor;
  rt: SsAttributePartColorKeyValueColor;
  lb: SsAttributePartColorKeyValueColor;
  rb: SsAttributePartColorKeyValueColor;
}

struct PartAttributeVertex {
  lt: Vec2;
  rt: Vec2;
  lb: Vec2;
  rb: Vec2;
}

table PartAttributeDeform {
  coordinate: [Vec2];
  index: [short];
}

struct PartAttributeShader {
  id_hash: uint32; // instead of id: string;
  param0: float;
  param1: float;
  param2: float;
  param3: float;
  param4: float;
  param5: float;
  param6: float;
  param7: float;
  map0_id: int;
  map0_name_hash: uint32; // instead of map0_name: string;
  map1_id: int;
  map1_name_hash: uint32; // instead of map1_name: string;
}

enum UpdateAttributeFlags: ulong (bit_flags) {
  AttributeCell,
  AttributePosX,
  AttributePosY,
  AttributePosZ,
  AttributeRotX,
  AttributeRotY,
  AttributeRotZ,
  AttributeSclX,
  AttributeSclY,
  AttributeLosclX,
  AttributeLosclY,
  AttributeAlpha,
  AttributeLoAlpha,
  AttributePrio,
  AttributeFlipH,
  AttributeFlipV,
  AttributeHide,
  AttributePartColor,
  AttributeShader,
  AttributeVertex,
  AttributePivotX,
  AttributePivotY,
  AttributeAnchorX,
  AttributeAnchorY,
  AttributeSizeX,
  AttributeSizeY,
  AttributeImgFlipH,
  AttributeImgFlipV,
  AttributeUvtX,
  AttributeUvtY,
  AttributeUvrZ,
  AttributeUvsX,
  AttributeUvsY,
  AttributeBoundr,
  AttributeMask,
  AttributeSkew,
  AttributeDeform,
  AttributeTexture,
}

struct PartState {
  part_index: ushort;

  update_flag: UpdateAttributeFlags;

  cell: PartAttributeCell;
  position_x: float;
  position_y: float;
  position_z: float;
  rotation_x: float;
  rotation_y: float;
  rotation_z: float;
  scale_x: float;
  scale_y: float;
  local_scale_x: float;
  local_scale_y: float;
  opacity: float;
  localopacity: float;
  priority: int;
  flip_v: bool;
  flip_h: bool;
  hide: bool;
  parts_color: PartAttributePartColor;
  shader: PartAttributeShader;
  vertex: PartAttributeVertex;
  pivot_x: float;
  pivot_y: float;
  anchor_x: float;
  anchor_y: float;
  size_x: float;
  size_y: float;
  img_flip_h: bool;
  img_flip_v: bool;
  uv_move_x: float;
  uv_move_y: float;
  uv_move_z: float;
  uv_scale_x: float;
  uv_scale_y: float;
  bounding_radius: float;
  mask: float;
  skew_x: float;
  skew_y: float;
  deform: int; // index of FrameData.deforms
  texture: int;
}

table FrameData {
  parts: [PartState];
  deforms: [PartAttributeDeform];
}

root_type FrameData;
