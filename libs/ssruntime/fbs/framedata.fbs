namespace ss.runtime;

struct PartAttributeCell {
 cellmap_name_hash: uint32; // fnv1a(cellmap name without .ssce)
 name_hash: uint32; // fnv1a(cell name)
}

struct Vec2 {
  x: float;
  y: float;
}

struct U8Rect {
  a: ubyte;
  r: ubyte;
  g: ubyte;
  b: ubyte;
}

struct  SsAttributePartColorKeyValueColor {
  rgba: U8Rect;
  rate: float;
}

enum BlendType: ubyte {
  Mix,
  Mul,
  Add,
  Sub,
  Mulalpha,
  Screen,
  Exclusion,
  Invert,
  Mul2,
  Div2,
  Screen2,
  Overlay2,
}

struct PartAttributePartColor {
  blend_type: BlendType;

  lt: SsAttributePartColorKeyValueColor;
  rt: SsAttributePartColorKeyValueColor;
  lb: SsAttributePartColorKeyValueColor;
  rb: SsAttributePartColorKeyValueColor;
}

struct PartAttributeVertex {
  lt: Vec2;
  rt: Vec2;
  lb: Vec2;
  rb: Vec2;
  center: Vec2;
}

table PartAttributeDeform {
  coordinate: [Vec2];
  index: [short];
}

struct PartAttributeShader {
  id_hash: uint32;
  param0: float;
  param1: float;
  param2: float;
  param3: float;
  param4: float;
  param5: float;
  param6: float;
  param7: float;
  map0_cellmap_name_hash: uint32; // fnv1a(cellmap name without .ssce)
  map0_name_hash: uint32;
  map1_cellmap_name_hash: uint32; // fnv1a(cellmap name without .ssce)
  map1_name_hash: uint32;
}

enum UpdateAttributeFlags: ulong (bit_flags) {
  AttributeCell,
  AttributePosX,
  AttributePosY,
  AttributePosZ,
  AttributeRotX,
  AttributeRotY,
  AttributeRotZ,
  AttributeSclX,
  AttributeSclY,
  AttributeLosclX,
  AttributeLosclY,
  AttributeAlpha,
  AttributeLoAlpha,
  AttributePrio,
  AttributeFlipH,
  AttributeFlipV,
  AttributeHide,
  AttributePartColor,
  AttributeShader,
  AttributeVertex,
  AttributePivotX,
  AttributePivotY,
  AttributeAnchorX,
  AttributeAnchorY,
  AttributeSizeX,
  AttributeSizeY,
  AttributeImgFlipH,
  AttributeImgFlipV,
  AttributeUvtX,
  AttributeUvtY,
  AttributeUvrZ,
  AttributeUvsX,
  AttributeUvsY,
  AttributeBoundr,
  AttributeMask,
  AttributeSkew,
  AttributeDeform,
  AttributeTexture,
}

struct PartState {
  update_flag: UpdateAttributeFlags;

  position_x: float;
  position_y: float;
  position_z: float;

  rotation_x: float;
  rotation_y: float;
  rotation_z: float;

  scale_x: float;
  scale_y: float;
  local_scale_x: float;
  local_scale_y: float;

  alpha: float;
  local_alpha: float;
  priority: float;

  pivot_x: float;
  pivot_y: float;
  anchor_x: float;
  anchor_y: float;
  size_x: float;
  size_y: float;

  uv_translation_x: float;
  uv_translation_y: float;
  uv_rotation_z: float;
  uv_scale_x: float;
  uv_scale_y: float;

  bounding_radius: float;
  mask: float;
  skew_x: float;
  skew_y: float;

  texture: uint32;

  part_index: short;
  cell: short;
  part_color: short;
  shader: short;
  vertex: short;
  deform: short;

  flip_h: bool;
  flip_v: bool;
  hide: bool;
  img_flip_h: bool;
  img_flip_v: bool;
}

enum DrawBatchKind: ubyte {
  Normal,
  Shape,
  Instance,
  Effect,
  Mesh,
  Text,
  Nines,
  Mask,
}

struct DrawBatch {
  start_rank: ushort;
  count: ushort;
  texture_hash: uint32;
  vertex_count: ushort;
  index_count: ushort;
  blend_type: BlendType;
  kind: DrawBatchKind;
  flags: ubyte;
  _reserved: ubyte;
}

table FrameData {
  parts: [PartState];

  cells: [PartAttributeCell];
  parts_color: [PartAttributePartColor];
  shaders: [PartAttributeShader];
  vertices: [PartAttributeVertex];
  deforms: [PartAttributeDeform];

  draw_order: [ushort];
  draw_batches: [DrawBatch];
}

root_type FrameData;
