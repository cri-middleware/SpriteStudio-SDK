include "common_ssfb2.fbs";

namespace ss.ssfb2;

table DataFontBitmapExtendSplit {
	name_project:string;
}

table DataFontBitmapSplit {
    version:ss.basetype.DataVersion;
    name:string;

    name_face:string;
    size:ushort;
    padding_l:ushort;
    padding_r:ushort;
    padding_u:ushort;
    padding_d:ushort;
    base:short;
    height_line:short;
    scale:ss.basetype.Vector2;
	spacing:ss.basetype.Vector2;
    size_texture_original:ss.basetype.Vector2;

    name_texture:[string];
    table_data:[ss.basetype.LibraryDataFontGryphBitmap];

    extend_split:DataFontBitmapExtendSplit;
}


// Split-Format:Font-Bitmap
file_identifier "SSF2";
root_type DataFontBitmapSplit;

