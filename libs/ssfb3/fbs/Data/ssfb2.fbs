include "common_ssfb2.fbs";

namespace ss.ssfb2;

table DataCellMap {
    version:ss.basetype.DataVersion;

    index_texture:[short];
    table_cell_map:[ss.basetype.LibraryDataCellMap];
}

table DataAnimation {
    version:ss.basetype.DataVersion;
    name:string;
    table_parts:[ss.basetype.DataModelParts];
    catalog_parts:Catalog;
    table_animation:[LibraryDataAnimation];
    table_animation_parts_setup:[ss.basetype.DataSetup];
}

table DataEffect {
    version:ss.basetype.DataVersion;
    name:string;
//    flag_data:ss.basetype.DataEffectFlagBit;
    flag_data:int;

    seed_random:int;
    version_renderer:int;

    count_max_particle:int;
    count_frame_per_second:int;

    scale_layout:ss.basetype.Vector2;

    table_parts:[DataEffectParts];
    table_emitter:[DataEffectEmitter];
    table_index_emitter_order_draw:[int];
}

table SequencePack {
    version:ss.basetype.DataVersion;
    name:string;
    sequence_list:[ss.basetype.DataSequence];
}

table FontBitmap {
    version:ss.basetype.DataVersion;
    name:string;

    name_face:string;
    size:ushort;
    padding_l:ushort;
    padding_r:ushort;
    padding_u:ushort;
    padding_d:ushort;
    base:short;
    height_line:short;
    scale:ss.basetype.Vector2;
    spacing:ss.basetype.Vector2;
    size_texture_original:ss.basetype.Vector2;

    name_texture:[string];
    table_data:[ss.basetype.LibraryDataFontGryphBitmap];
}

table DataSoundList {
    version:ss.basetype.DataVersion;
    name:string;
    table_data:[ss.basetype.LibraryDataSound];
}

table ProjectData {
    version:ss.basetype.DataVersion;
    name:string;
    cell_map:DataCellMap;
    animation:[DataAnimation];
    effect:[DataEffect];
    sequence:[SequencePack];
    soundlist:[DataSoundList];
    fontbitmap:[FontBitmap];
    name_texture:[string];
    name_texture_external:[string];
    name_font_bitmap:[string];
}


// Marged-Format
file_identifier "SFB2";
root_type ProjectData;

