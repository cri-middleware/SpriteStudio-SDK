include "../type_base.fbs";

namespace ss.runtime;

enum FlagUpdateAttribute:uint {
    CLEAR = 0x00000000,

    STATUS = 0x00000001,
    CELL = 0x00000002,
    RATE_OPACITY = 0x00000004,
    PRIORITY = 0x00000008,

    POSITION = 0x00000010,
    ROTATION = 0x00000020,
    SCALING = 0x00000040,
    SCALING_LOCAL = 0x00000080,

    PARTSCOLOR = 0x00000100,
    VERTEX_CORRECTION = 0x00000200,
    SKEW = 0x00000400,
    OFFSET_PIVOT = 0x00000800,

    SIZE_FORCE = 0x00001000,
    POSITION_TEXTURE = 0x00002000,
    SCALING_TEXTURE = 0x00004000,
    ROTATION_TEXTURE = 0x00008000,

    POSITION_ANCHOR = 0x00010000,
    RADIUS_COLLISION = 0x00020000,
    USERDATA = 0x00040000,
    SIGNAL = 0x00080000,

    INSTANCE = 0x00100000,
    EFFECT = 0x00200000,
    DEFORM = 0x00400000,
    SHADER = 0x00800000,

    AUDIO = 0x01000000,
    CHANGE_TEXTURE = 0x02000000,
}
enum FlagIndexCallBack:ushort {
    TURN_BACK = 0x8000,
    MASK_INDEX = 0x7fff,
}

table ValueUserData {
    frame:short;
    data:ss.basetype.AnimationAttributeUserData;
}
table ValueSignal {
    frame:short;
    data:ss.basetype.AnimationAttributeSignal;
}
table ValueAudio {
    frame:short;
    data:ss.basetype.AnimationAttributeAudio;
}

table SegmentTRS {
    id_parts:short;
    flag_update:FlagUpdateAttribute;

    position:ss.basetype.Vector3;
    rotation:ss.basetype.Vector3;
    scaling:ss.basetype.Vector2;
}

table SegmentIntersection {
    id_parts:short;
    flag_update:FlagUpdateAttribute;

    status:ss.basetype.FlagBitStatusAnimationAttribute;
    scaling_local:ss.basetype.Vector2;
    size_force:ss.basetype.Vector2;
    radius_collision:float;
    user_data:[FlagIndexCallBack];  // index // [ValueUserData]
    instance:short;                 // frame // ss.basetype.AnimationAttributeInstance;
    effect:short;                   // frame // ss.basetype.AnimationAttributeEffect;
    signal:[FlagIndexCallBack];     // index // [ValueSignal]
    audio:[FlagIndexCallBack];      // index // [ValueAudio]
}

table SegmentDraw {
    id_parts:short;
    flag_update:FlagUpdateAttribute;

    cell:ss.basetype.AnimationAttributeCell;
    rate_opacity:float;
    priority:int;
    parts_color:ss.basetype.AnimationAttributePartsColor;
    vertex_correction:ss.basetype.AnimationAttributeVertexCorrection;
    skew:ss.basetype.AnimationAttributeSkew;
    offset_pivot:ss.basetype.Vector2;
    position_anchor:ss.basetype.Vector2;
    position_texture:ss.basetype.Vector2;
    rotation_texture:float;
    scaling_texture:ss.basetype.Vector2;
    deform:[ss.basetype.Vector2];	// :ss.basetype.AnimationAttributeDeform;
    shader:ss.basetype.AnimationAttributeShader;
    change_texture:ss.basetype.AnimationAttributeChangeTexture;
}
