table Vec2 {
  x: float;
  y: float;
}
table Vec3 {
  x: float;
  y: float;
  z: float;
}
table Rect {
  x1: float;
  y1: float;
  x2: float;
  y2: float;
}

enum TexFilterMode: ubyte {
  Nearest,
  Linear,
}

enum RenderBlendType: ubyte {
  Mix,
  Add,
}


enum TexWrapMode: ubyte {
  Clamp,
  Repeat,
  Mirror,
}

enum MeshDivType: ubyte {
  Unknown,
  PolylineBase,
  Boxdiv,
}

enum PartType: ubyte {
  Null,
  Normal,
  Shape,
  Text,
  Nines,
  Instance,
  Armature,
  Effect,
  Mesh,
  Movenode,
  Constraint,
  Mask,
  Joint,
  Bonepoint,
  TransformConstraint,
  Camera,
  Audio,
}

enum BoundsType : ubyte {
  None,
  Quad,
  Aabb,
  Circle,
  CircleSmin,
  CircleSmax,
}

enum InheritType : ubyte {
  Parent,
  Self,
}

enum BlendType : ubyte {
  Mix,
  Mul,
  Add,
  Sub,
  Mulalpha,
  Screen,
  Exclusion,
  Invert,
}


table UserDataInteger {
  integer : int;
}

table UserDataRect {
  rect: Rect;
}

table UserDataPoint {
  point: Vec2;
}

table UserDataString {
  data : string;
}

union UserDataValue {
  UserDataInteger,
  UserDataRect,
  UserDataPoint,
  UserDataString,
}

table UserDataValueWrapper {
  content: UserDataValue;
}

table UserDataItem {
  flags : short;
  index : short;
  data : [UserDataValueWrapper];
}

table UserDataPerFrame {
  frame_index : short;
  data : [UserDataItem];
}

table SignalDataPerFrame {
  frame_index : short;
  // TODO: impl
}

table AudioDataPerFrame {
  frame_index : short;
  // TODO: impl
}

table Cell {
  name: string (key);

  rectangle: Rect;
  pivot: Vec2;
  rotated: bool;

  table_coordinate:[Vec2];
  table_index_vertex:[ushort];
}

table CellMap {
  name: string (key);

  image_path: string;
  size_original: Vec2;

  wrap_mode: TexWrapMode;
  filter_mode: TexFilterMode;

  cells: [Cell];
}

enum EffectNodeType: ubyte {
    Root,
    Emitter,
    Particle,
}

table EffectParticleInfiniteEmitEnabled {
  flag : int;
}

table EffectParticleTurnToDirectionEnabled {
  rotation : float;
}

table EffectParticlePointGravity {
  position: Vec2;
  power : float;
}

table EffectParticleElementTransSize {
  size: Rect;

  scale_factor_min_value : float;
  scale_factor_max_value : float;
}

table EffectParticleElementSize {
  size: Rect;
  scale_factor_min_value : float;
  scale_factor_max_value : float;
}

table EffectParticleElementAlphaFade {
  disprange_min_value : float;
  disprange_max_value : float;
}

table EffectParticleElementTransColor {
  color_min_value : uint;
  color_max_value : uint;
}

table EffectParticleElementInitColor {
  color_min_value : uint;
  color_max_value : uint;
}

table EffectParticleElementTangentialAcceleration {
  acceleration_min_value : float;
  acceleration_max_value : float;
}

table EffectParticleElementTransSpeed {
  speed_min_value : float;
  speed_max_value : float;
}

table EffectParticleElementRotationTrans {
  rotation_factor : float;
  end_life_time_per : float;
}

table EffectParticleElementRotation {
  rotation_min_value : float;
  rotation_max_value : float;
  rotation_add_min_value : float;
  rotation_add_max_value : float;
}

table EffectParticleElementPosition {
  offset: Rect;
}

table EffectParticleElementGravity {
  gravity: Vec2;
}

table EffectParticleElementDelay {
  delay_time : int;
}

table EffectParticleElementRndSeedChange {
  seed : int;
}

table EffectParticleElementBasic {
  priority: int;
  maximum_particle: int;
  attime_create: int;
  interval: int;
  lifetime: int;
  speed_min_value : float;
  speed_max_value : float;
  lifespan_min_value : int;
  lifespan_max_value : int;
  angle : float;
  angle_variance : float;
}

union EffectNodeBehavior {
  EffectParticleElementBasic,
  EffectParticleElementRndSeedChange,
  EffectParticleElementDelay,
  EffectParticleElementGravity,
  EffectParticleElementPosition,
  EffectParticleElementRotation,
  EffectParticleElementRotationTrans,
  EffectParticleElementTransSpeed,
  EffectParticleElementTangentialAcceleration,
  EffectParticleElementInitColor,
  EffectParticleElementTransColor,
  EffectParticleElementAlphaFade,
  EffectParticleElementSize,
  EffectParticleElementTransSize,
  EffectParticlePointGravity,
  EffectParticleTurnToDirectionEnabled,
  EffectParticleInfiniteEmitEnabled,
}

table EffectNodeBehaviorWrapper {
  content: EffectNodeBehavior;
}

table EffectNode {
  index : short;
  parent_index : short;
  type : EffectNodeType;
  cell_index : short;
  blend_type : RenderBlendType;
  behavior : [EffectNodeBehaviorWrapper];
}

table Effect {
  name: string (key);
  fps: short;
  is_lock_rand_seed: short;
  lock_rand_seed: short;
  layout_scale: Vec2;
  effect_node : [EffectNode];
}

table SoundFile {
  name: string (key);
  path: string;
  time_total: uint;
}

table SoundList {
  name: string (key);
  table_data:[SoundFile];
}

table FontGlyphBitmap {
  id: uint (key);
  atlas: Rect;
  offset: Vec2;
  width_advance: float;
  text: string;
  page: byte;
  channel: byte;
}

table FontBitmap {
  name:string (key);

  name_face: string;
  size: ushort;
  padding_l: ushort;
  padding_r: ushort;
  padding_u: ushort;
  padding_d: ushort;
  base: short;
  height_line: short;
  scale: Vec2;
  spacing: Vec2;
  size_texture_original: Vec2;

  name_texture:[string];
  table_data:[FontGlyphBitmap];
}
