table Vec2 {
  v1: float;
  v2: float;
}

table Vec3 {
  v1: float;
  v2: float;
  v3: float;
}

table Rect {
  x1: float;
  y1: float;
  x2: float;
  y2: float;
}

table U8Rect {
  a: ubyte;
  r: ubyte;
  g: ubyte;
  b: ubyte;
}

enum TexFilterMode: ubyte {
  Nearest,
  Linear,
}

enum RenderBlendType: ubyte {
  Mix,
  Add,
}

enum TexWrapMode: ubyte {
  Clamp,
  Repeat,
  Mirror,
}

enum MeshDivType: ubyte {
  Unknown,
  PolylineBase,
  Boxdiv,
}

enum PartType: ubyte {
  Null,
  Normal,
  Shape,
  Text,
  Nines,
  Instance,
  Armature,
  Effect,
  Mesh,
  Movenode,
  Constraint,
  Mask,
  Joint,
  Bonepoint,
  TransformConstraint,
  Camera,
  Audio,
}

enum BoundsType : ubyte {
  None,
  Quad,
  Aabb,
  Circle,
  CircleSmin,
  CircleSmax,
}

enum InheritType : ubyte {
  Parent,
  Self,
}

enum BlendType : ubyte {
  Mix,
  Mul,
  Add,
  Sub,
  Mulalpha,
  Screen,
  Exclusion,
  Invert,
}

table BoolValueTable {
  value: bool;
}

table IntValueTable {
  value: int;
}

table FloatValueTable {
  value: float;
}

table Vec2ValueTable {
  value: Vec2;
}

table RectValueTable {
  value: Rect;
}

table StringValueTable {
  value: string;
}

table AttributeCell {
 map_id: int;
 name: string;
}

table AttributePartsColor {
 rgba: U8Rect;
 rate: float;
}

table AttributeShader {
  id: string;
  param0: float;
  param1: float;
  param2: float;
  param3: float;
  param4: float;
  param5: float;
  param6: float;
  param7: float;
  map0_id: int;
  map0_name: string;
  map1_id: int;
  map1_name: string;
}

table AttributeVertex {
  lt: Vec2;
  rt: Vec2;
  lb: Vec2;
  rb: Vec2;
}

table AttributeInstance {
  infinity_flag: bool;
  pingpong: bool;
  independent: bool;
  loop_num: int;
  start_label: string;
  start_offset: int;
  end_label: string;
  end_offset: int;
  speed: float;
}

table AttributeEffect {
  start_time: int;
  speed: float;
  independent: bool;
}

table AttributeVertexDeformation {
  // TODO: impl
}

table AttributeSkew {
  // TODO: impl
}

table AttributeDeform {
  // TODO: impl
}

union Attribute {
  AttributeCell,
  AttributePosX: FloatValueTable,
  AttributePosY: FloatValueTable,
  AttributePosZ: FloatValueTable,
  AttributeRotX: FloatValueTable,
  AttributeRotY: FloatValueTable,
  AttributeRotZ: FloatValueTable,
  AttributeSclX: FloatValueTable,
  AttributeSclY: FloatValueTable,
  AttributeLosclX: FloatValueTable,
  AttributeLosclY: FloatValueTable,
  AttributeAlpha: FloatValueTable,
  AttributeLoAlpha: FloatValueTable,
  AttributePrio: IntValueTable,
  AttributeFlipH: BoolValueTable,
  AttributeFlipV: BoolValueTable,
  AttributeHide: BoolValueTable,
  AttributePartsColor,
  AttributeShader,
  AttributeVertex,
  AttributePivotX: FloatValueTable,
  AttributePivotY: FloatValueTable,
  AttributeAnchorX: FloatValueTable,
  AttributeAnchorY: FloatValueTable,
  AttributeSizeX: FloatValueTable,
  AttributeSizeY: FloatValueTable,
  AttributeImgFlipH: BoolValueTable,
  AttributeImgFlipV: BoolValueTable,
  AttributeUvtX: FloatValueTable,
  AttributeUvtY: FloatValueTable,
  AttributeUvrZ: FloatValueTable,
  AttributeUvsX: FloatValueTable,
  AttributeUvsY: FloatValueTable,
  AttributeBoundr: FloatValueTable,
  AttributeMask: FloatValueTable,
  AttributeInstance,
  AttributeEffect,
  AttributeVertexDeformation,
  AttributeSkew,
  AttributeDeform,
}

table AttributeWrapper {
  value: Attribute;
}

union UserDataValue {
  UserDataInteger: IntValueTable,
  UserDataRect: RectValueTable,
  UserDataPoint: Vec2ValueTable,
  UserDataString: StringValueTable,
}

table UserDataValueWrapper {
  value: UserDataValue;
}

table UserDataItem {
  part_index: short (key);
  value: [UserDataValueWrapper];
}

// table UserData {
//   items: [UserDataItem];
// }

enum SignalComamndParamType: ubyte {
  Index,
  Integer,
  Floating,
  None,
}

table SignalComamndParam {
  param_id: string;
  type: SignalComamndParamType;
  value: float;
}

table SignalDataItem {
  part_index: short (key);

  active: bool;
  command_id: string;
  params: [SignalComamndParam];
}

// table SignalData {
//   items: [SignalDataItem];
// }

table AudioDataItem {
  part_index: short (key);

  sound_list_id: int;
  sound_name: string;
  loop_num: int;
}

/*
table AudioData {
  items: [AudioDataItem];
}
*/

table TextureChangeDataItem {
  part_index: short (key);

  texture_name: string;
}

// table TextureChangeData {
//   items: [TextureChangeDataItem];
// }

// union EventData {
//   UserData,
//   SignalData,
//   AudioData,
//   TextureChangeData,
// }

// table EventDataWrapper {
//   value: EventData;
// }

table EventsPerFrame {
  frame_index: short (key);

  // events: [EventDataWrapper];
  user: [UserDataItem];
  signal: [SignalDataItem];
  audio: [AudioDataItem];
  texture: [TextureChangeDataItem];
}

table Cell {
  name: string (key);

  rectangle: Rect;
  pivot: Vec2;
  rotated: bool;

  table_coordinate:[Vec2];
  table_index_vertex:[ushort];
}

table CellMap {
  name: string (key);

  image_path: string;
  size_original: Vec2;

  wrap_mode: TexWrapMode;
  filter_mode: TexFilterMode;

  cells: [Cell];
}

enum EffectNodeType: ubyte {
  Root,
  Emitter,
  Particle,
}

table EffectParticlePointGravity {
  position: Vec2;
  power : float;
}

table RectAndVec2ValueTable {
  size: Rect;
  scale_factor_value: Vec2; // min, max
}

table EffectParticleElementTransColor {
  color_min_value : uint;
  color_max_value : uint;
}

table EffectParticleElementInitColor {
  color_min_value : uint;
  color_max_value : uint;
}

table EffectParticleElementRotationTrans {
  rotation_factor : float;
  end_life_time_per : float;
}

table EffectParticleElementRotation {
  rotation_value: Vec2; // min, max
  rotation_add_value: Vec2; // min, max
}

table EffectParticleElementBasic {
  priority: int;
  maximum_particle: int;
  attime_create: int;
  interval: int;
  lifetime: int;
  speed_min_value : float;
  speed_max_value : float;
  lifespan_min_value : int;
  lifespan_max_value : int;
  angle : float;
  angle_variance : float;
}

union EffectNodeBehavior {
  EffectParticleElementBasic,
  EffectParticleElementRndSeedChange: IntValueTable,
  EffectParticleElementDelay: IntValueTable,
  EffectParticleElementGravity: Vec2ValueTable,
  EffectParticleElementPosition: RectValueTable,
  EffectParticleElementRotation,
  EffectParticleElementRotationTrans,
  EffectParticleElementTransSpeed: Vec2ValueTable,
  EffectParticleElementTangentialAcceleration: Vec2ValueTable,
  EffectParticleElementInitColor,
  EffectParticleElementTransColor,
  EffectParticleElementAlphaFade: Vec2ValueTable,
  EffectParticleElementSize: RectAndVec2ValueTable,
  EffectParticleElementTransSize: RectAndVec2ValueTable,
  EffectParticlePointGravity,
  EffectParticleTurnToDirectionEnabled: FloatValueTable,
  EffectParticleInfiniteEmitEnabled: IntValueTable,
}

table EffectNodeBehaviorWrapper {
  value: EffectNodeBehavior;
}

table EffectNode {
  index : short;
  parent_index : short;
  type : EffectNodeType;
  cell_index : short;
  blend_type : RenderBlendType;
  behavior : [EffectNodeBehaviorWrapper];
}

table Effect {
  name: string (key);
  fps: short;
  is_lock_rand_seed: short;
  lock_rand_seed: short;
  layout_scale: Vec2;
  effect_node : [EffectNode];
}

table SoundFile {
  name: string (key);
  time_total: uint;
}

table SoundList {
  name: string (key);
  table_data:[SoundFile];
}

table FontGlyphBitmap {
  id: uint (key);
  atlas: Rect;
  offset: Vec2;
  width_advance: float;
  text: string;
  page: byte;
  channel: byte;
}

table FontBitmap {
  name: string (key);

  name_face: string;
  size: ushort;
  padding_l: ushort;
  padding_r: ushort;
  padding_u: ushort;
  padding_d: ushort;
  base: short;
  height_line: short;
  scale: Vec2;
  spacing: Vec2;
  size_texture_original: Vec2;

  name_texture: [string];
  table_data: [FontGlyphBitmap];
}

table MeshDataUV {
  uv: [float];
}

table MeshDataIndices {
  indices: [float];
}

/*
// for runtime
table PartAttributes {
  cell_index: short;
  position_x: float;
  position_y: float;
  position_z: float;
  rotation_x: float;
  rotation_y: float;
  rotation_z: float;
  scale_x: float;
  scale_y: float;
  localscale_x: float;
  localscale_y: float;
  opacity: short;
  localopacity: short;
  priority: short;
  flip_v: bool;
  flip_h: bool;
  hide: bool;
  mask: short;
  pivot_x: float;
  pivot_y: float;
  size_x: float;
  size_y: float;
  uv_move_x: float;
  uv_move_y: float;
  uv_rotation: float;
  uv_scale_x: float;
  uv_scale_y: float;
  bounding_radius: float;
  instance: InstanceAttribute;
  effect: EffectAttribute;

  // vertex_deformation:
  // skew:
  // deform:
  // parts_color:
}
*/

table PartAttributeInstance {
  cur_keyframe: int;
  start_frame: int;
  end_frame: int;
  loop_num: int;
  speed: float;
  loopflag: int;
}

table PartAttributeEffect {
  cur_keyframe: int;
  start_time: int;
  speed: float;
  loopflag: int;
}


table PartAttributes {
  cell_index: short;
  position: Vec3;
  rotation: Vec3;
  scale: Vec2;
  local_scale: Vec2;
  opacity: short;
  localopacity: short;
  priority: short;
  flip_v: bool;
  flip_h: bool;
  hide: bool;
  mask: short;
  pivot: Vec2;
  size: Vec2;
  uv_move: Vec2;
  uv_rotation: float;
  uv_scale: Vec2;
  bounding_radius: float;
  instance: PartAttributeInstance;
  effect: PartAttributeEffect;

  // vertex_deformation:
  // skew:
  // deform:
  // parts_color:
}

table PartData {
  index: short (key);
  name: string;
  parent_index: short;
  type: PartType;
  bounds_type: BoundsType;
  alpha_blend_type: BlendType;
  refname: string; // instance name
  effect_filename: string;
  color_label: string;
  mask_influence: short;
}

table PartState {
  index: short;
  attributes: [AttributeWrapper];
}

table Label {
  name: string (key);
  time: int;
}

table AnimationData {
  name: string (key);

  setup_animation: [PartAttributes];
  frame_data: [PartState];

  events: [EventsPerFrame];

  label_data: [Label];

  meshs_data_uv: [MeshDataUV];
  meshs_data_indices: [MeshDataIndices];

  start_frames: short;
  end_frames: short;
  total_frames: short;
  fps : short;

  canvas: Rect;
}

table SsAnimeBinary {
  version: uint = 0x00000001;

  parts : [PartData];
  animations: [AnimationData];

  cell_map: [CellMap];
  effect: [Effect];
  sound_list: [SoundList];
  font_bitmap: [FontBitmap];
  instances: [AnimationData];
}

file_identifier "SSAB";
file_extension "ssab";
root_type SsAnimeBinary;
