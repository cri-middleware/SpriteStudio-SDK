table Vec2 {
  x: float;
  y: float;
}

table Rect {
  x1: float;
  y1: float;
  x2: float;
  y2: float;
}

enum TexFilterMode: ubyte {
  Nearest,
  Linear,
}

enum RenderBlendType: ubyte {
  Mix,
  Add,
}

enum TexWrapMode: ubyte {
  Clamp,
  Repeat,
  Mirror,
}

enum MeshDivType: ubyte {
  Unknown,
  PolylineBase,
  Boxdiv,
}

enum PartType: ubyte {
  Null,
  Normal,
  Shape,
  Text,
  Nines,
  Instance,
  Armature,
  Effect,
  Mesh,
  Movenode,
  Constraint,
  Mask,
  Joint,
  Bonepoint,
  TransformConstraint,
  Camera,
  Audio,
}

enum BoundsType : ubyte {
  None,
  Quad,
  Aabb,
  Circle,
  CircleSmin,
  CircleSmax,
}

enum InheritType : ubyte {
  Parent,
  Self,
}

enum BlendType : ubyte {
  Mix,
  Mul,
  Add,
  Sub,
  Mulalpha,
  Screen,
  Exclusion,
  Invert,
}

enum AttributeKind: ubyte {
  Cell,
  PosX,
  PosY,
  PosZ,
  RotX,
  RotY,
  RotZ,
  SclX,
  SclY,
  LosclX,
  LosclY,
  Alpha,
  LoAlpha,
  Prio,
  FlipH,
  FlipV,
  Hide,
  PartsColor,
  Shader,
  Vertex,
  PivotX,
  PivotY,
  AnchorX,
  AnchorY,
  SizeX,
  SizeY,
  ImgFlipH,
  ImgFlipV,
  UvtX,
  UvtY,
  UvrZ,
  UvsX,
  UvsY,
  Boundr,
  Mask,
  User,
  Signal,
  Instance,
  Effect,
}

table AttributeBool {
  value: bool;
}

table AttributeInt {
  value: int;
}

table AttributeFloat {
  value: float;
}

table AttributeCell {
  // TODO: impl
}

table AttributePartsColor {
  // TODO: impl
}

table AttributeShader {
  // TODO: impl
}

table AttributeVertex {
  // TODO: impl
}

table AttributeUser {
  // TODO: impl
}

table AttributeSignal {
  // TODO: impl
}

table AttributeInstance {
  // TODO: impl
}

table AttributeEffect {
  // TODO: impl
}

union Attribute {
  AttributeCell,
  AttributePosX: AttributeFloat,
  AttributePosY: AttributeFloat,
  AttributePosZ: AttributeFloat,
  AttributeRotX: AttributeFloat,
  AttributeRotY: AttributeFloat,
  AttributeRotZ: AttributeFloat,
  AttributeSclX: AttributeFloat,
  AttributeSclY: AttributeFloat,
  AttributeLosclX: AttributeFloat,
  AttributeLosclY: AttributeFloat,
  AttributeAlpha: AttributeFloat,
  AttributeLoAlpha: AttributeFloat,
  AttributePrio: AttributeInt,
  AttributeFlipH: AttributeBool,
  AttributeFlipV: AttributeBool,
  AttributeHide: AttributeBool,
  AttributePartsColor,
  AttributeShader,
  AttributeVertex,
  AttributePivotX: AttributeBool,
  AttributePivotY: AttributeBool,
  AttributeAnchorX: AttributeBool,
  AttributeAnchorY: AttributeBool,
  AttributeSizeX: AttributeBool,
  AttributeSizeY: AttributeBool,
  AttributeImgFlipH: AttributeBool,
  AttributeImgFlipV: AttributeBool,
  AttributeUvtX: AttributeBool,
  AttributeUvtY: AttributeBool,
  AttributeUvrZ: AttributeBool,
  AttributeUvsX: AttributeBool,
  AttributeUvsY: AttributeBool,
  AttributeBoundr: AttributeFloat,
  AttributeMask: AttributeFloat,
  AttributeUser,
  AttributeSignal,
  AttributeInstance,
  AttributeEffect,
}

table AttributeWrapper {
  content: Attribute;
}

table UserDataInteger {
  integer : int;
}

table UserDataRect {
  rect: Rect;
}

table UserDataPoint {
  point: Vec2;
}

table UserDataString {
  data : string;
}

union UserDataValue {
  UserDataInteger,
  UserDataRect,
  UserDataPoint,
  UserDataString,
}

table UserDataValueWrapper {
  content: UserDataValue;
}

table UserDataItem {
  flags: short;
  index: short;
  data: [UserDataValueWrapper];
}

table UserDataPerFrame {
  frame_index: short;
  data: [UserDataItem];
}

enum SignalComamndParamType: ubyte {
  Index,
  Integer,
  Floating,
  None,
}

table SignalComamndParam {
  param_id: string;
  type: SignalComamndParamType;
  value: float;
}

table SignalDataPerFrame {
  frame_index: short;

  active: bool;
  command_id: string;
  params: [SignalComamndParam];
}

table AudioDataPerFrame {
  frame_index: short;

  sound_list_id: int;
  sound_name: string;
  loop_num: int;
}

table TextureChangeDataPerFrame {
  frame_index: short;
  texture_name: string;
}

table Cell {
  name: string (key);

  rectangle: Rect;
  pivot: Vec2;
  rotated: bool;

  table_coordinate:[Vec2];
  table_index_vertex:[ushort];
}

table CellMap {
  name: string (key);

  image_path: string;
  size_original: Vec2;

  wrap_mode: TexWrapMode;
  filter_mode: TexFilterMode;

  cells: [Cell];
}

enum EffectNodeType: ubyte {
    Root,
    Emitter,
    Particle,
}

table EffectParticleInfiniteEmitEnabled {
  flag : int;
}

table EffectParticleTurnToDirectionEnabled {
  rotation : float;
}

table EffectParticlePointGravity {
  position: Vec2;
  power : float;
}

table EffectParticleElementTransSize {
  size: Rect;

  scale_factor_min_value : float;
  scale_factor_max_value : float;
}

table EffectParticleElementSize {
  size: Rect;
  scale_factor_min_value : float;
  scale_factor_max_value : float;
}

table EffectParticleElementAlphaFade {
  disprange_min_value : float;
  disprange_max_value : float;
}

table EffectParticleElementTransColor {
  color_min_value : uint;
  color_max_value : uint;
}

table EffectParticleElementInitColor {
  color_min_value : uint;
  color_max_value : uint;
}

table EffectParticleElementTangentialAcceleration {
  acceleration_min_value : float;
  acceleration_max_value : float;
}

table EffectParticleElementTransSpeed {
  speed_min_value : float;
  speed_max_value : float;
}

table EffectParticleElementRotationTrans {
  rotation_factor : float;
  end_life_time_per : float;
}

table EffectParticleElementRotation {
  rotation_min_value : float;
  rotation_max_value : float;
  rotation_add_min_value : float;
  rotation_add_max_value : float;
}

table EffectParticleElementPosition {
  offset: Rect;
}

table EffectParticleElementGravity {
  gravity: Vec2;
}

table EffectParticleElementDelay {
  delay_time : int;
}

table EffectParticleElementRndSeedChange {
  seed : int;
}

table EffectParticleElementBasic {
  priority: int;
  maximum_particle: int;
  attime_create: int;
  interval: int;
  lifetime: int;
  speed_min_value : float;
  speed_max_value : float;
  lifespan_min_value : int;
  lifespan_max_value : int;
  angle : float;
  angle_variance : float;
}

union EffectNodeBehavior {
  EffectParticleElementBasic,
  EffectParticleElementRndSeedChange,
  EffectParticleElementDelay,
  EffectParticleElementGravity,
  EffectParticleElementPosition,
  EffectParticleElementRotation,
  EffectParticleElementRotationTrans,
  EffectParticleElementTransSpeed,
  EffectParticleElementTangentialAcceleration,
  EffectParticleElementInitColor,
  EffectParticleElementTransColor,
  EffectParticleElementAlphaFade,
  EffectParticleElementSize,
  EffectParticleElementTransSize,
  EffectParticlePointGravity,
  EffectParticleTurnToDirectionEnabled,
  EffectParticleInfiniteEmitEnabled,
}

table EffectNodeBehaviorWrapper {
  content: EffectNodeBehavior;
}

table EffectNode {
  index : short;
  parent_index : short;
  type : EffectNodeType;
  cell_index : short;
  blend_type : RenderBlendType;
  behavior : [EffectNodeBehaviorWrapper];
}

table Effect {
  name: string (key);
  fps: short;
  is_lock_rand_seed: short;
  lock_rand_seed: short;
  layout_scale: Vec2;
  effect_node : [EffectNode];
}

table SoundFile {
  name: string (key);
  time_total: uint;
}

table SoundList {
  name: string (key);
  table_data:[SoundFile];
}

table FontGlyphBitmap {
  id: uint (key);
  atlas: Rect;
  offset: Vec2;
  width_advance: float;
  text: string;
  page: byte;
  channel: byte;
}

table FontBitmap {
  name:string (key);

  name_face: string;
  size: ushort;
  padding_l: ushort;
  padding_r: ushort;
  padding_u: ushort;
  padding_d: ushort;
  base: short;
  height_line: short;
  scale: Vec2;
  spacing: Vec2;
  size_texture_original: Vec2;

  name_texture:[string];
  table_data:[FontGlyphBitmap];
}

table MeshDataUV {
    uv : [float];
}
table MeshDataIndices {
    indices : [float];
}

table InstanceAttribute {
  cur_keyframe: int;
  start_frame: int;
  end_frame: int;
  loop_num: int;
  speed: float;
  loopflag: int;
}

table EffectAttribute {
  cur_keyframe: int;
  start_time: int;
  speed: float;
  loopflag: int;
}

table PartAttributes {
  cell_index: short;
  position_x: float;
  position_y: float;
  position_z: float;
  rotation_x: float;
  rotation_y: float;
  rotation_z: float;
  scale_x: float;
  scale_y: float;
  localscale_x: float;
  localscale_y: float;
  opacity: short;
  localopacity: short;
  priority: short;
  flip_v: bool;
  flip_h: bool;
  hide: bool;
  mask: short;
  pivot_x: float;
  pivot_y: float;
  size_x: float;
  size_y: float;
  uv_move_x: float;
  uv_move_y: float;
  uv_rotation: float;
  uv_scale_x: float;
  uv_scale_y: float;
  bounding_radius: float;
  instance: InstanceAttribute;
  effect: EffectAttribute;

  // vertex_deformation:
  // skew:
  // deform:
  // parts_color:
}

table PartData {
  name: string;
  index: short;
  parent_index: short;
  type: PartType;
  bounds_yype: BoundsType;
  alpha_blend_type: BlendType;
  refname: string;
  effect_filename: string;
  color_label: string;
  mask_influence: short;
}

table PartState {
  index: short;
  attributes: [AttributeWrapper];
}

table Label {
  name: string (key);
  time: int;
}

table AnimationData {
  name: string (key);

  setup_animation: [PartAttributes];
  frame_data: [PartState];
  user_data: [UserDataPerFrame];
  signal_data: [SignalDataPerFrame];
  audio_data: [AudioDataPerFrame];
  texture_change: [TextureChangeDataPerFrame];

  label_data: [Label];

  meshs_data_uv: [MeshDataUV];
  meshs_data_indices: [MeshDataIndices];

  start_frames: short;
  end_frames: short;
  total_frames: short;
  fps : short;

  canvas: Rect;
}

table SsAnimeBinary {
  version: uint = 0x00000001;

  parts : [PartData];
  animations: [AnimationData];

  cell_map: [CellMap];
  effect: [Effect];
  sound_list: [SoundList];
  font_bitmap: [FontBitmap];
  instances: [AnimationData];
}

file_identifier "SSAB";
file_extension "ssab";
root_type SsAnimeBinary;
