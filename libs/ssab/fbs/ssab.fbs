table Vec2 {
  v1: float;
  v2: float;
}

table Vec3 {
  v1: float;
  v2: float;
  v3: float;
}

table Rect {
  x1: float;
  y1: float;
  x2: float;
  y2: float;
}

table U8Rect {
  a: ubyte;
  r: ubyte;
  g: ubyte;
  b: ubyte;
}

enum TexFilterMode: ubyte {
  Nearest,
  Linear,
}

enum RenderBlendType: ubyte {
  Mix,
  Add,
}

enum TexWrapMode: ubyte {
  Clamp,
  Repeat,
  Mirror,
}

enum MeshDivType: ubyte {
  Unknown,
  PolylineBase,
  Boxdiv,
}

enum BoundsType : ubyte {
  None,
  Quad,
  Aabb,
  Circle,
  CircleSmin,
  CircleSmax,
}

enum InheritType : ubyte {
  Parent,
  Self,
}

enum BlendType : ubyte {
  Mix,
  Mul,
  Add,
  Sub,
  Mulalpha,
  Screen,
  Exclusion,
  Invert,
}

enum InterpolationType : ubyte {
  None,

  Linear,
  Hermite,
  Bezier,
  Acceleration,
  Deceleration,

  EaseIn,
  EaseOut,
  EaseInOut,

  EaseExponentialIn,
  EaseExponentialOut,
  EaseExponentialInOut,

  EaseSineIn,
  EaseSineOut,
  EaseSineInOut,

  EaseElasticIn,
  EaseElasticOut,
  EaseElasticInOut,

  EaseBounceIn,
  EaseBounceOut,
  EaseBounceInOut,

  EaseBackIn,
  EaseBackOut,
  EaseBackInOut,
}

table IntValueEntry {
  value: int;
}

table FloatValueEntry {
  value: float;
}

table Vec2ValueEntry {
  value: Vec2;
}

table RectValueEntry {
  value: Rect;
}

table EventUserData {
  part_index: ushort (key);

  value: PartAttributeUserData;
}

table EventSignal {
  part_index: ushort (key);

  value: PartAttributeSignal;
}

table EventAudio {
  part_index: ushort (key);

  value: PartAttributeAudio;
}

table EventInstance {
  part_index: ushort (key);

  value: PartAttributeInstance;
}

table EventEffect {
  part_index: ushort (key);

  value: PartAttributeEffect;
}

table EventsPerFrame {
  frame_index: ushort (key);

  user: [EventUserData];
  signal: [EventSignal];
  audio: [EventAudio];
  instance: [EventInstance];
  effect: [EventEffect];
}

table Cell {
  name: string (key);

  rectangle: Rect;
  pivot: Vec2;
  rotated: bool;

  table_coordinate: [Vec2];
  table_index_vertex: [ushort];
}

table CellMap {
  name: string (key);

  image_path: string;
  size_original: Vec2;

  wrap_mode: TexWrapMode;
  filter_mode: TexFilterMode;

  cells: [Cell];
}

enum EffectNodeType: ubyte {
  Root,
  Emitter,
  Particle,
}

table EffectParticlePointGravity {
  position: Vec2;
  power : float;
}

table RectAndVec2ValueTable {
  size: Rect;
  scale_factor_value: Vec2; // min, max
}

table EffectParticleElementTransColor {
  color_min_value : uint;
  color_max_value : uint;
}

table EffectParticleElementInitColor {
  color_min_value : uint;
  color_max_value : uint;
}

table EffectParticleElementRotationTrans {
  rotation_factor : float;
  end_life_time_per : float;
}

table EffectParticleElementRotation {
  rotation_value: Vec2; // min, max
  rotation_add_value: Vec2; // min, max
}

table EffectParticleElementBasic {
  priority: int;
  maximum_particle: int;
  attime_create: int;
  interval: int;
  lifetime: int;
  speed_min_value : float;
  speed_max_value : float;
  lifespan_min_value : int;
  lifespan_max_value : int;
  angle : float;
  angle_variance : float;
}

union EffectNodeBehavior {
  EffectParticleElementBasic,
  EffectParticleElementRndSeedChange: IntValueEntry,
  EffectParticleElementDelay: IntValueEntry,
  EffectParticleElementGravity: Vec2ValueEntry,
  EffectParticleElementPosition: RectValueEntry,
  EffectParticleElementRotation,
  EffectParticleElementRotationTrans,
  EffectParticleElementTransSpeed: Vec2ValueEntry,
  EffectParticleElementTangentialAcceleration: Vec2ValueEntry,
  EffectParticleElementInitColor,
  EffectParticleElementTransColor,
  EffectParticleElementAlphaFade: Vec2ValueEntry,
  EffectParticleElementSize: RectAndVec2ValueTable,
  EffectParticleElementTransSize: RectAndVec2ValueTable,
  EffectParticlePointGravity,
  EffectParticleTurnToDirectionEnabled: FloatValueEntry,
  EffectParticleInfiniteEmitEnabled: IntValueEntry,
}

table EffectNodeBehaviorWrapper {
  value: EffectNodeBehavior;
}

table EffectNode {
  index : short;
  parent_index : short;
  type : EffectNodeType;
  cell_index : short;
  blend_type : RenderBlendType;
  behavior : [EffectNodeBehaviorWrapper];
}

table Effect {
  name: string (key);
  fps: short;
  is_lock_rand_seed: short;
  lock_rand_seed: short;
  layout_scale: Vec2;
  effect_node : [EffectNode];
}

table SoundFile {
  name: string (key);
  time_total: uint;
}

table SoundList {
  name: string (key);
  table_data:[SoundFile];
}

table FontGlyphBitmap {
  id: ushort (key);
  atlas: Rect;
  offset: Vec2;
  width_advance: float;
  text: string;
  page: byte;
  channel: byte;
}

table FontBitmap {
  name: string (key);

  name_face: string;
  size: ushort;
  padding_l: ushort;
  padding_r: ushort;
  padding_u: ushort;
  padding_d: ushort;
  base: short;
  height_line: short;
  scale: Vec2;
  spacing: Vec2;
  size_texture_original: Vec2;

  name_texture: [string];
  table_data: [FontGlyphBitmap];
}

table PartAttributeCell {
 map_id: int; // hash or name
 name: string;
}

table  SsAttributePartsColorKeyValueColor {
  rgba: U8Rect;
  rate: float;
}

table PartAttributePartsColor {
  blend_type: BlendType;

  lt: SsAttributePartsColorKeyValueColor;
  rt: SsAttributePartsColorKeyValueColor;
  lb: SsAttributePartsColorKeyValueColor;
  rb: SsAttributePartsColorKeyValueColor;
}

table PartAttributeVertex {
  lt: Vec2;
  rt: Vec2;
  lb: Vec2;
  rb: Vec2;
}

table PartAttributeInstance {
  pingpong: bool;
  independent: bool;
  loop_num: int;
  start_label: string;
  start_offset: int;
  end_label: string;
  end_offset: int;
  speed: float;
}

table PartAttributeEffect {
  cur_keyframe: int;
  start_time: int;
  speed: float;
  loopflag: int;
}

table PartAttributeDeform {
  coordinate: [Vec2];
  index: [short];
}

table PartAttributeShader {
  id: string;
  param0: float;
  param1: float;
  param2: float;
  param3: float;
  param4: float;
  param5: float;
  param6: float;
  param7: float;
  map0_id: int;
  map0_name: string;
  map1_id: int;
  map1_name: string;
}

table PartAttributeUserData {
  integer: IntValueEntry;
  rect: Rect;
  point: Vec2;
  str: string;
}

enum SignalCommandParamType: ubyte {
  Index,
  Integer,
  Floating,
  None,
}

table SignalCommandParam {
  param_id: string;
  type: SignalCommandParamType;
  value: float;
}

table PartAttributeSignal {
  active: bool;
  command_id: string;
  params: [SignalCommandParam];
}

table PartAttributeAudio {
  sound_list_id: int;
  sound_name: string;
  loop_num: int;
}

table PartAttributes {
  cell: PartAttributeCell;
  position: Vec3;
  rotation: Vec3;
  scale: Vec2;
  local_scale: Vec2;
  opacity: short;
  localopacity: short;
  priority: short;
  flip_v: bool;
  flip_h: bool;
  hide: bool;
  parts_color: PartAttributePartsColor;
  shader: PartAttributeShader;
  vertex: PartAttributeVertex;
  pivot: Vec2;
  size: Vec2;
  uv_move: Vec3;
  uv_scale: Vec2;
  bounding_radius: float;
  mask: float;
  skew: Vec2;
  deform: PartAttributeDeform;

  texture: int;
}

table PartTypeNone {
  // nothing
}

enum ShapeType : ubyte {
  Unknown,
  Triangle,
  Rectangle,
  Arrow,
  Star,
}

table PartTypeShape {
  shape_type: ShapeType;
  shape_mask: bool;
}

enum TextAnchor : ubyte {
  NO = 0xFF,

  LT = 0x00,
  LC = 0x01,
  LB = 0x02,
  CT = 0x10,
  CC = 0x11,
  CB = 0x12,
  RT = 0x20,
  RC = 0x21,
  RB = 0x22,
}

table PartTypeText {
  text: string;
  text_bitmap: bool;
  text_family: string;
  text_char_map: string;
  text_size: int;
  text_space: float;
  text_smooth: bool;
  text_mask: bool;
  text_width: int;
  text_height: int;
  e_anchor: TextAnchor;
}

table PartTypeNines {
  nines_margin_l: int;
  nines_margin_r: int;
  nines_margin_t: int;
  nines_margin_b: int;
  nines_fill_mode: int;
  nines_mask: bool;
}

table PartTypeInstance {
  ref_anime: string;
}

table PartTypeEffect {
  ref_effect_name: string;
}

union PartType {
  PartTypeNull: PartTypeNone,
  PartTypeNormal: PartTypeNone,
  PartTypeShape,
  PartTypeText,
  PartTypeNines,
  PartTypeInstance,
  PartTypeArmature: PartTypeNone,
  PartTypeEffect,
  PartTypeMesh: PartTypeNone,
  PartTypeMovenode: PartTypeNone,
  PartTypeConstraint: PartTypeNone,
  PartTypeMask: PartTypeNone,
  PartTypeJoint: PartTypeNone,
  PartTypeBonepoint: PartTypeNone,
  PartTypeTransformConstraint: PartTypeNone,
  PartTypeCamera: PartTypeNone,
  PartTypeAudio: PartTypeNone,
}

table PartData {
  name: string;
  parent_index: short;
  bounds_type: BoundsType;
  blend_type: BlendType;

  type: PartType;
}

table Label {
  name: string (key);
  time: int;
}

table PartAnimationDataCellValue {
  index: ushort (key);

  value: PartAttributeCell;
}

table PartAnimationDataFloatValue {
  index: ushort (key);
  interpolation: InterpolationType = None;

  value: float;
}

table PartAnimationDataIntValue {
  index: ushort (key);
  interpolation: InterpolationType = None;

  value: int;
}

table PartAnimationDataBoolValue {
  index: ushort (key);

  value: bool;
}

table PartAnimationDataPartsColor {
  index: ushort (key);
  interpolation: InterpolationType = None;

  value: PartAttributePartsColor;
}

table PartAnimationDataShader {
  index: ushort (key);
  interpolation: InterpolationType = None;

  value: PartAttributeShader;
}

table PartAnimationDataVertex {
  index: ushort (key);
  interpolation: InterpolationType = None;

  value: PartAttributeVertex;
}

table PartAnimationDataInstance {
  index: ushort (key);

  value: PartAttributeInstance;
}

table PartAnimationDataEffect {
  index: ushort (key);

  value: PartAttributeEffect;
}

table PartAnimationDataVec2 {
  index: ushort (key);
  interpolation: InterpolationType = None;

  value: Vec2;
}

table PartAnimationDataDeform {
  index: ushort (key);
  interpolation: InterpolationType = None;

  value: PartAttributeDeform;
}

table PartAnimationData {
  cell_array: [PartAnimationDataCellValue];
  pos_x_array: [PartAnimationDataFloatValue];
  pos_y_array: [PartAnimationDataFloatValue];
  pos_z_array: [PartAnimationDataFloatValue];
  rot_x_array: [PartAnimationDataFloatValue];
  rot_y_array: [PartAnimationDataFloatValue];
  rot_z_array: [PartAnimationDataFloatValue];
  scl_x_array: [PartAnimationDataFloatValue];
  scl_y_array: [PartAnimationDataFloatValue];
  loscl_x_array: [PartAnimationDataFloatValue];
  loscl_y_array: [PartAnimationDataFloatValue];
  alpha_array: [PartAnimationDataFloatValue];
  lo_alpha_array: [PartAnimationDataFloatValue];
  prio_array: [PartAnimationDataIntValue];
  flip_h_array: [PartAnimationDataBoolValue];
  flip_v_array: [PartAnimationDataBoolValue];
  hide_array: [PartAnimationDataBoolValue];
  parts_color_array: [PartAnimationDataPartsColor];
  shader_array: [PartAnimationDataShader];
  vertex_array: [PartAnimationDataVertex];
  pivot_x_array: [PartAnimationDataFloatValue];
  pivot_y_array: [PartAnimationDataFloatValue];
  anchor_x_array: [PartAnimationDataFloatValue];
  anchor_y_array: [PartAnimationDataFloatValue];
  size_x_array: [PartAnimationDataFloatValue];
  size_y_array: [PartAnimationDataFloatValue];
  img_flip_h_array: [PartAnimationDataBoolValue];
  img_flip_v_array: [PartAnimationDataBoolValue];
  uvt_x_array: [PartAnimationDataFloatValue];
  uvt_y_array: [PartAnimationDataFloatValue];
  uvr_z_array: [PartAnimationDataFloatValue];
  uvs_x_array: [PartAnimationDataFloatValue];
  uvs_y_array: [PartAnimationDataFloatValue];
  boundr_array: [PartAnimationDataFloatValue];
  mask_array: [PartAnimationDataFloatValue];
  skew_array: [PartAnimationDataVec2];
  deform_array: [PartAnimationDataDeform];
  texture_array: [PartAnimationDataIntValue];
}

table PartMeshData {
  part_index: ushort (key);

  uv: [float];
  indices: [int];
  count_coordinate_mesh: int;
  index_coordinate_deform: [int];
}

table AnimationData {
  name: string (key);

  initial_data: [PartAttributes];
  part_animation_data: [PartAnimationData];
  part_mesh_data: [PartMeshData];

  events: [EventsPerFrame];

  label_data: [Label];

  start_frames: short;
  end_frames: short;
  total_frames: short;
  fps: short;

  canvas: Rect;
}

table SsAnimeBinary {
  version: uint = 0x00000001;

  name: string;

  parts : [PartData];
  animations: [AnimationData];

  cell_map: [CellMap];
  effect: [Effect];
  sound_list: [SoundList];
  font_bitmap: [FontBitmap];

  external_instances: [string];
}

file_identifier "SSAB";
file_extension "ssab";
root_type SsAnimeBinary;
