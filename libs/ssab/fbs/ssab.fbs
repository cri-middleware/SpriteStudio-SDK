include "common.fbs";


table Part {
  name: string;
  index: int;
  parent_index: int;
  type: PartType;
  bounds_type: BoundsType;
  inherit_type: InheritType;
  alpha_blend_type: BlendType;
  effect_filename: string;
  color_label: string;
  mask_influence: bool;
}

table PartAnime {
  part_name: string;
  // TODO: impl
}

table MeshBindInfo {
  weight: [int];
  bone_index: [int];
  offset: [Vec2];
  bind_bone_num: int;
}

table MeshBind {
  mesh_vertices_bind_array: [MeshBindInfo];
}

table Model {
  part_list: [Part];
  setup_animation: string;

  mesh_list: [MeshBind];
  // bone_list: HashMap<String, i32>,
}

table Label {
  name: string;
  time: int;
}


table AnimationSettings {
  fps: int;
  frame_count: int;
  canvas_size: Vec2;
  pivot: Vec2;
  start_frame: int;
  end_frame: int;
}

table Animation {
  name: string (key);
  part_animes: [PartAnime];

  labels: [Label];

  user_data: [UserDataPerFrame];
  signal_data: [SignalDataPerFrame];
  audio_data: [AudioDataPerFrame];

  start_frames: short;
  end_frames: short;
  total_frames: short;
  fps : short;
}

table AnimePack {
  name: string (key);
  settings: AnimationSettings;
  model: Model;
  anime_list: [Animation];
}


table SsAnimeBinary {
  version: uint = 0x00000001;

  animation_pack: AnimePack;

  cell_map: [CellMap];
  effect: [Effect];
  sound_list: [SoundList];
  font_bitmap: [FontBitmap];
  instances: [Animation];
}

file_identifier "SSAB";
root_type SsAnimeBinary;
