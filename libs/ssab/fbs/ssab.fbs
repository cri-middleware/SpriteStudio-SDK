namespace ss.format;

table Vec2 {
  v1: float;
  v2: float;
}

table Bounds {
  left: float;
  top: float;
  right: float;
  bottom: float;
}

table Region {
  x: float;
  y: float;
  w: float;
  h: float;
}

table MinMax2 {
  x_min: float;
  y_min: float;
  x_max: float;
  y_max: float;
}

table U8Color {
  a: ubyte;
  r: ubyte;
  g: ubyte;
  b: ubyte;
}

struct KeyCurve {
  start_time: float;
  start_value: float;
  end_time: float;
  end_value: float;
}

enum TexFilterMode: ubyte {
  Nearest,
  Linear,
}

enum RenderBlendType: ubyte {
  Mix,
  Add,
}

enum TexWrapMode: ubyte {
  Clamp,
  Repeat,
  Mirror,
}

enum MeshDivType: ubyte {
  Unknown,
  PolylineBase,
  Boxdiv,
}

enum BoundsType: ubyte {
  None,
  Quad,
  Aabb,
  Circle,
  CircleSmin,
  CircleSmax,
}

enum InheritType: ubyte {
  Parent,
  Self,
}

enum BlendType: ubyte {
  Mix,
  Mul,
  Add,
  Sub,
  Mulalpha,
  Screen,
  Exclusion,
  Invert,
  Mul2,
  Div2,
  Screen2,
  Overlay2,
}

enum InterpolationType: ubyte {
  None,

  Linear,
  Hermite,
  Bezier,
  Acceleration,
  Deceleration,

  EaseIn,
  EaseOut,
  EaseInOut,

  EaseExponentialIn,
  EaseExponentialOut,
  EaseExponentialInOut,

  EaseSineIn,
  EaseSineOut,
  EaseSineInOut,

  EaseElasticIn,
  EaseElasticOut,
  EaseElasticInOut,

  EaseBounceIn,
  EaseBounceOut,
  EaseBounceInOut,

  EaseBackIn,
  EaseBackOut,
  EaseBackInOut,
}

table NoneValueEntry {
}

table BoolValueEntry {
  value: bool;
}

table IntValueEntry {
  value: int;
}

table FloatValueEntry {
  value: float;
}

table StringValueEntry {
  value: string (required);
}

table Vec2ValueEntry {
  value: Vec2 (required);
}

table MinMax2ValueEntry {
  value: MinMax2 (required);
}

table EventUserData {
  part_index: ushort (key);

  value: PartAttributeUserData (required);
}

table EventSignal {
  part_index: ushort (key);

  value: PartAttributeSignal (required);
}

table EventAudio {
  part_index: ushort (key);

  value: PartAttributeAudio (required);
}

table EventInstance {
  part_index: ushort (key);

  value: PartAttributeInstance (required);
}

table EventEffect {
  part_index: ushort (key);

  value: PartAttributeEffect (required);
}

table EventsPerFrame {
  frame_index: ushort (key);

  users: [EventUserData];
  signals: [EventSignal];
  audios: [EventAudio];
  instances: [EventInstance];
  effects: [EventEffect];
}

table Cell {
  name_hash: uint32 (key);
  name: string (required);

  region: Region (required);
  pivot: Vec2 (required);
  rotated: bool;

  table_coord_x: [float];
  table_coord_y: [float];
  table_index_vertex: [ushort];
}

table CellMap {
  name_hash: uint32 (key);
  name: string (required);

  image_path: string (required);
  image_path_hash: uint32; // fnv1a(image_path); used as embedded_assets key when embedded
  size_original: Vec2 (required);

  wrap_mode: TexWrapMode;
  filter_mode: TexFilterMode;

  cells: [Cell];
}

enum EffectNodeType: ubyte {
  Root,
  Emitter,
  Particle,
}

table EffectParticlePointGravity {
  position: Vec2 (required);
  power: float;
}

table MinMax2AndVec2ValueTable {
  size: MinMax2;
  scale_factor_value: Vec2 (required); // min, max
}

table EffectParticleElementTransColor {
  color_min_value: uint;
  color_max_value: uint;
}

table EffectParticleElementInitColor {
  color_min_value: uint;
  color_max_value: uint;
}

table EffectParticleElementRotationTrans {
  rotation_factor: float;
  end_life_time_per: float;
}

table EffectParticleElementRotation {
  rotation_value: Vec2 (required); // min, max
  rotation_add_value: Vec2 (required); // min, max
}

table EffectParticleElementBasic {
  priority: int;
  maximum_particle: int;
  attime_create: int;
  interval: int;
  lifetime: int;
  speed_min_value: float;
  speed_max_value: float;
  lifespan_min_value: int;
  lifespan_max_value: int;
  angle: float;
  angle_variance: float;
}

union EffectNodeBehavior {
  EffectParticleElementBasic,
  EffectParticleElementRndSeedChange: IntValueEntry,
  EffectParticleElementDelay: IntValueEntry,
  EffectParticleElementGravity: Vec2ValueEntry,
  EffectParticleElementPosition: MinMax2ValueEntry,
  EffectParticleElementRotation,
  EffectParticleElementRotationTrans,
  EffectParticleElementTransSpeed: Vec2ValueEntry,
  EffectParticleElementTangentialAcceleration: Vec2ValueEntry,
  EffectParticleElementInitColor,
  EffectParticleElementTransColor,
  EffectParticleElementAlphaFade: Vec2ValueEntry,
  EffectParticleElementSize: MinMax2AndVec2ValueTable,
  EffectParticleElementTransSize: MinMax2AndVec2ValueTable,
  EffectParticlePointGravity,
  EffectParticleTurnToDirectionEnabled: FloatValueEntry,
  EffectParticleInfiniteEmitEnabled: IntValueEntry,
}

table EffectNodeBehaviorWrapper {
  value: EffectNodeBehavior;
}

table EffectNode {
  index: short;
  parent_index: short;
  effect_node_type: EffectNodeType;
  cell_name_hash: uint32;
  cell_map_name_hash: uint32;
  blend_type: RenderBlendType;
  behavior: [EffectNodeBehaviorWrapper];
}

table Effect {
  name_hash: uint32 (key);
  name: string (required);
  fps: short;
  is_lock_rand_seed: bool;
  lock_rand_seed: short;
  layout_scale: Vec2 (required);
  effect_node: [EffectNode] (required);
}

table SoundFile {
  name_hash: uint32 (key);
  name: string;
  file_path: string;
  file_path_hash: uint32; // fnv1a(file_path); used as embedded_assets key when embedded
  time_total: uint;
}

table SoundList {
  name_hash: uint32 (key);
  name: string;
  table_data:[SoundFile];
}

table FontGlyphBitmap {
  id: ushort (key);
  atlas: Region;
  offset: Vec2;
  width_advance: float;
  text: string;
  page: byte;
  channel: byte;
}

table FontBitmap {
  name_hash: uint32 (key);
  name: string;

  name_face: string;
  size: ushort;
  padding_l: ushort;
  padding_r: ushort;
  padding_u: ushort;
  padding_d: ushort;
  base: short;
  height_line: short;
  scale: Vec2;
  spacing: Vec2;
  size_texture_original: Vec2;

  name_texture: [string];
  name_texture_hash: [uint32]; // fnv1a(name_texture[i]); used as embedded_assets key when embedded
  table_data: [FontGlyphBitmap];
}

table PartMeshBinding {
  vertex_influence_offset: [uint32];
  influence_bone:          [ushort];
  influence_weight:        [float];
  influence_coord_x:       [float];
  influence_coord_y:       [float];
}

table PartAttributeCell {
 cellmap_name_hash: uint32; // fnv1a(cellmap name without .ssce)
 name_hash: uint32; // fnv1a(cell name)
}

table  SsAttributePartColorKeyValueColor {
  rgba: U8Color;
  rate: float;
}

table PartAttributePartColor {
  blend_type: BlendType;

  lt: SsAttributePartColorKeyValueColor;
  rt: SsAttributePartColorKeyValueColor;
  lb: SsAttributePartColorKeyValueColor;
  rb: SsAttributePartColorKeyValueColor;
}

table PartAttributeVertex {
  lt: Vec2;
  rt: Vec2;
  lb: Vec2;
  rb: Vec2;
}
table PartAttributeInstance {
  pingpong: bool;
  independent: bool;
  loop_num: int;
  start_label_hash: uint32;
  start_offset: int;
  end_label_hash: uint32;
  end_offset: int;
  speed: float;
  reverse: bool;
}

table PartAttributeEffect {
  start_time: int;
  speed: float;
  independent: bool;
}

table PartAttributeDeform {
  coord_x: [float];
  coord_y: [float];
  index: [short];
}

table PartAttributeShader {
  id: string (required);
  id_hash: uint32;
  param0: float;
  param1: float;
  param2: float;
  param3: float;
  param4: float;
  param5: float;
  param6: float;
  param7: float;
  map0_cellmap_name_hash: uint32; // fnv1a(cellmap name without .ssce)
  map0_name_hash: uint32;
  map1_cellmap_name_hash: uint32; // fnv1a(cellmap name without .ssce)
  map1_name_hash: uint32;
}

table PartAttributeUserData {
  integer: IntValueEntry;
  rect: Bounds;
  point: Vec2;
  str: string;
}

enum SignalCommandParamType: ubyte {
  Bool,
  Index,
  Integer,
  Floating,
  Text,
  None,
}

union SignalCommandParamValue {
  Bool: BoolValueEntry,
  Index: IntValueEntry,
  Integer: IntValueEntry,
  Floating: FloatValueEntry,
  Text: StringValueEntry,
  None: NoneValueEntry,
}

table SignalCommandParam {
  param_id: string (required);
  type: SignalCommandParamType;
  value: SignalCommandParamValue (required);
}

table PartAttributeSignal {
  active: bool;
  command_id: string (required);
  params: [SignalCommandParam] (required);
}

table PartAttributeAudio {
  sound_list_name_hash: uint32; // fnv1a(SoundList.name) — addresses SoundList
  sound_name_hash: uint32;      // fnv1a(alias) — addresses SoundFile within the SoundList
  sound_name: string (required);// alias (kept for diagnostics)
  loop_num: int;
}

enum PartAttributesUpdateFlags: ulong (bit_flags) {
  AttributeCell,
  AttributePosX,
  AttributePosY,
  AttributePosZ,
  AttributeRotX,
  AttributeRotY,
  AttributeRotZ,
  AttributeSclX,
  AttributeSclY,
  AttributeLosclX,
  AttributeLosclY,
  AttributeAlpha,
  AttributeLoAlpha,
  AttributePrio,
  AttributeFlipH,
  AttributeFlipV,
  AttributeHide,
  AttributePartColor,
  AttributeShader,
  AttributeVertex,
  AttributePivotX,
  AttributePivotY,
  AttributeAnchorX,
  AttributeAnchorY,
  AttributeSizeX,
  AttributeSizeY,
  AttributeImgFlipH,
  AttributeImgFlipV,
  AttributeUvtX,
  AttributeUvtY,
  AttributeUvrZ,
  AttributeUvsX,
  AttributeUvsY,
  AttributeBoundr,
  AttributeMask,
  AttributeSkew,
  AttributeDeform,
  AttributeTexture,
//  AttributeUserData,    // Reserved
//  AttributeSignal,      // Reserved
//  AttributeAudio,       // Reserved
//  AttributeInstance,    // Reserved
//  AttributeEffect,      // Reserved
}

table InitialPartAttributes {
  update_flag: PartAttributesUpdateFlags = 0;

  cell: PartAttributeCell;
  position_x: float = 0.0;
  position_y: float = 0.0;
  position_z: float = 0.0;
  rotation_x: float = 0.0;
  rotation_y: float = 0.0;
  rotation_z: float = 0.0;
  scale_x: float = 1.0;
  scale_y: float = 1.0;
  local_scale_x: float = 1.0;
  local_scale_y: float = 1.0;
  alpha: float = 1.0;
  local_alpha: float = 1.0;
  priority: int = 0;
  flip_h: bool = false;
  flip_v: bool = false;
  hide: bool = false;
  part_color: PartAttributePartColor;
  shader: PartAttributeShader;
  vertex: PartAttributeVertex;
  pivot_x: float = 0.0;
  pivot_y: float = 0.0;
  anchor_x: float = 0.0;
  anchor_y: float = 0.0;
  size_x: float = 1.0;
  size_y: float = 1.0;
  img_flip_h: bool = false;
  img_flip_v: bool = false;
  uv_translation_x: float = 0.0;
  uv_translation_y: float = 0.0;
  uv_rotation_z: float = 0.0;
  uv_scale_x: float = 1.0;
  uv_scale_y: float = 1.0;
  bounding_radius: float = 0.0;
  mask: float = 0.0;
  skew_x: float = 0.0;
  skew_y: float = 0.0;
  deform: PartAttributeDeform;

  texture: uint32 = 0;
}

table InitialEvents {
  user: PartAttributeUserData;
  signal: PartAttributeSignal;
  audio: PartAttributeAudio;
  instance: PartAttributeInstance;
  effect: PartAttributeEffect;
}

enum ShapeType: ubyte {
  Unknown,
  Triangle,
  Rectangle,
  Arrow,
  Star,
}

table PartTypeShape {
  shape_type: ShapeType;
}

enum TextAnchor: ubyte {
  NO = 0xFF,

  LT = 0x00,
  LC = 0x01,
  LB = 0x02,
  CT = 0x10,
  CC = 0x11,
  CB = 0x12,
  RT = 0x20,
  RC = 0x21,
  RB = 0x22,
}

table PartTypeText {
  text: string;
  text_bitmap: bool;
  text_family: string;
  text_char_map: string;
  text_size: int;
  text_space: float;
  text_smooth: bool;
  text_width: int;
  text_height: int;
  e_anchor: TextAnchor;
}

table PartTypeNines {
  nines_margin_l: int;
  nines_margin_r: int;
  nines_margin_t: int;
  nines_margin_b: int;
  nines_fill_mode: int;
}

table PartTypeInstance {
  ref_anime_pack: string (required);
  ref_anime_pack_hash: uint32;
  ref_anime_name: string (required);
  ref_anime_name_hash: uint32;
}

table PartTypeEffect {
  ref_effect_name_hash: uint32;
}

union PartType {
  PartTypeNull: NoneValueEntry,
  PartTypeNormal: NoneValueEntry,
  PartTypeShape,
  PartTypeText,
  PartTypeNines,
  PartTypeInstance,
  PartTypeArmature: NoneValueEntry,
  PartTypeEffect,
  PartTypeMesh: NoneValueEntry,
  PartTypeMovenode: NoneValueEntry,
  PartTypeConstraint: NoneValueEntry,
  PartTypeMask: NoneValueEntry,
  PartTypeJoint: NoneValueEntry,
  PartTypeBonepoint: NoneValueEntry,
  PartTypeTransformConstraint: NoneValueEntry,
  PartTypeCamera: NoneValueEntry,
  PartTypeAudio: NoneValueEntry,
}

table PartData {
  name: string (required);
  parent_index: short;
  bounds_type: BoundsType;
  blend_type: BlendType;
  visible_inside_mask: bool;
  mask_write: bool;
  mask_influence: bool;
  // Unified pure-mask flag for drawing parts (Shape/Text/Nines).
  draw_as_mask: bool;
  output_influence: bool = true;
  mesh_binding: PartMeshBinding;

  part_type: PartType;
}

table Label {
  name_hash: uint32 (key);
  name: string (required);
  time: int;
}

// One part's keyframes in one animation, an attribute at a time: the run in
// `SsAnimeBinary.keyframes` that holds them, or the default, 0xFFFFFFFF, when
// the animation has no keys for that attribute on this part.
table PartAnimationData {
  cell_keys: uint = 4294967295;
  position_x_keys: uint = 4294967295;
  position_y_keys: uint = 4294967295;
  position_z_keys: uint = 4294967295;
  rotation_x_keys: uint = 4294967295;
  rotation_y_keys: uint = 4294967295;
  rotation_z_keys: uint = 4294967295;
  scale_x_keys: uint = 4294967295;
  scale_y_keys: uint = 4294967295;
  local_scale_x_keys: uint = 4294967295;
  local_scale_y_keys: uint = 4294967295;
  alpha_keys: uint = 4294967295;
  local_alpha_keys: uint = 4294967295;
  priority_keys: uint = 4294967295;
  flip_h_keys: uint = 4294967295;
  flip_v_keys: uint = 4294967295;
  hide_keys: uint = 4294967295;
  part_color_keys: uint = 4294967295;
  shader_keys: uint = 4294967295;
  vertex_keys: uint = 4294967295;
  pivot_x_keys: uint = 4294967295;
  pivot_y_keys: uint = 4294967295;
  anchor_x_keys: uint = 4294967295;
  anchor_y_keys: uint = 4294967295;
  size_x_keys: uint = 4294967295;
  size_y_keys: uint = 4294967295;
  img_flip_h_keys: uint = 4294967295;
  img_flip_v_keys: uint = 4294967295;
  uv_translation_x_keys: uint = 4294967295;
  uv_translation_y_keys: uint = 4294967295;
  uv_rotation_z_keys: uint = 4294967295;
  uv_scale_x_keys: uint = 4294967295;
  uv_scale_y_keys: uint = 4294967295;
  bounding_radius_keys: uint = 4294967295;
  mask_keys: uint = 4294967295;
  skew_keys: uint = 4294967295;
  deform_keys: uint = 4294967295;
  texture_keys: uint = 4294967295;
}

// Every keyframe of every animation in the pack, one column per field: key `k`
// is `frame[k]`, `interpolation[k]`, `curve[k]` and `value[k]`. The keys of one
// attribute of one part in one animation are a run, in frame order, and runs
// with the same keys are stored once.
table Keyframes {
  // Where each run starts, plus where the last one ends: run `r` is keys
  // `runs[r]` up to, but not including, `runs[r + 1]`.
  runs: [uint] (required);
  frame: [ushort] (required);
  interpolation: [InterpolationType] (required);
  // An index into `curves` for Hermite and Bezier, into `easing_rates` for the
  // six ease types that take a rate, 0xFFFF for every other key.
  curve: [ushort] (required);
  // The value's bits, read by the attribute the run belongs to: a float's for
  // the float attributes, an int's for priority, 0 or 1 for the bool ones, the
  // texture hash for texture, and an index into the matching table below for
  // cell, part_color, shader, vertex, skew and deform.
  value: [uint] (required);

  // Each distinct value once.
  curves: [KeyCurve] (required);
  easing_rates: [float] (required);
  cells: [PartAttributeCell] (required);
  part_colors: [PartAttributePartColor] (required);
  shaders: [PartAttributeShader] (required);
  vertices: [PartAttributeVertex] (required);
  skews: [Vec2] (required);
  deforms: [PartAttributeDeform] (required);
}

table AnimationData {
  name: string (required);
  name_hash: uint32;

  parts_initial_attributes: [InitialPartAttributes] (required);
  parts_animation_data: [PartAnimationData] (required);

  events: [EventsPerFrame];
  initial_events: [InitialEvents];

  labels: [Label];

  start_frame: short;
  end_frame: short;
  total_frame: short;
  fps: short;

  canvas_size: Vec2 (required);
  pivot: Vec2 (required);
}

table ExternalTexture {
  name_hash: uint32 (key);
  name: string;
}

table ExternalInstance {
  anime_pack_name: string;
  anime_pack_name_hash: uint32;
  anime_name: string;
  anime_name_hash: uint32;
}

table EmbeddedAsset {
  name_hash: uint32 (key);
  name: string;

  data: [ubyte];
}

table SsAnimeBinary {
  version: uint;

  name: string (required);
  name_hash: uint32;

  parts: [PartData] (required);
  animations: [AnimationData] (required);

  cellmaps: [CellMap];
  effects: [Effect];
  sound_lists: [SoundList];
  font_bitmaps: [FontBitmap];

  external_textures: [ExternalTexture];
  external_instances: [ExternalInstance];

  embedded_assets: [EmbeddedAsset];

  keyframes: Keyframes (required);
}

file_identifier "SSAB";
file_extension "ssab";
root_type SsAnimeBinary;
