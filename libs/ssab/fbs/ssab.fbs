namespace ss.format;

table Vec2 {
  v1: float;
  v2: float;
}

table Rect {
  x1: float;
  y1: float;
  x2: float;
  y2: float;
}

table U8Rect {
  a: ubyte;
  r: ubyte;
  g: ubyte;
  b: ubyte;
}

table SsCurve {
  start_time: float;
  start_value: float;
  end_time: float;
  end_value: float;
}

enum TexFilterMode: ubyte {
  Nearest,
  Linear,
}

enum RenderBlendType: ubyte {
  Mix,
  Add,
}

enum TexWrapMode: ubyte {
  Clamp,
  Repeat,
  Mirror,
}

enum MeshDivType: ubyte {
  Unknown,
  PolylineBase,
  Boxdiv,
}

enum BoundsType: ubyte {
  None,
  Quad,
  Aabb,
  Circle,
  CircleSmin,
  CircleSmax,
}

enum InheritType: ubyte {
  Parent,
  Self,
}

enum BlendType: ubyte {
  Mix,
  Mul,
  Add,
  Sub,
  Mulalpha,
  Screen,
  Exclusion,
  Invert,
  Mul2,
  Div2,
  Screen2,
  Overlay2,
}

enum InterpolationType: ubyte {
  None,

  Linear,
  Hermite,
  Bezier,
  Acceleration,
  Deceleration,

  EaseIn,
  EaseOut,
  EaseInOut,

  EaseExponentialIn,
  EaseExponentialOut,
  EaseExponentialInOut,

  EaseSineIn,
  EaseSineOut,
  EaseSineInOut,

  EaseElasticIn,
  EaseElasticOut,
  EaseElasticInOut,

  EaseBounceIn,
  EaseBounceOut,
  EaseBounceInOut,

  EaseBackIn,
  EaseBackOut,
  EaseBackInOut,
}

table NoneValueEntry {
}

table BoolValueEntry {
  value: bool;
}

table IntValueEntry {
  value: int;
}

table FloatValueEntry {
  value: float;
}

table StringValueEntry {
  value: string;
}

table Vec2ValueEntry {
  value: Vec2;
}

table RectValueEntry {
  value: Rect;
}

table EventUserData {
  part_index: ushort (key);

  value: PartAttributeUserData;
}

table EventSignal {
  part_index: ushort (key);

  value: PartAttributeSignal;
}

table EventAudio {
  part_index: ushort (key);

  value: PartAttributeAudio;
}

table EventInstance {
  part_index: ushort (key);

  value: PartAttributeInstance;
}

table EventEffect {
  part_index: ushort (key);

  value: PartAttributeEffect;
}

table EventsPerFrame {
  frame_index: ushort (key);

  users: [EventUserData];
  signals: [EventSignal];
  audios: [EventAudio];
  instances: [EventInstance];
  effects: [EventEffect];
}

table Cell {
  name_hash: uint32 (key);
  name: string;

  rectangle: Rect;
  pivot: Vec2;
  rotated: bool;

  table_coord_x: [float];
  table_coord_y: [float];
  table_index_vertex: [ushort];
}

table CellMap {
  name_hash: uint32 (key);
  name: string;

  image_path: string;
  image_path_hash: uint32; // fnv1a(image_path); used as embedded_assets key when embedded
  size_original: Vec2;

  wrap_mode: TexWrapMode;
  filter_mode: TexFilterMode;

  cells: [Cell];
}

enum EffectNodeType: ubyte {
  Root,
  Emitter,
  Particle,
}

table EffectParticlePointGravity {
  position: Vec2;
  power: float;
}

table RectAndVec2ValueTable {
  size: Rect;
  scale_factor_value: Vec2; // min, max
}

table EffectParticleElementTransColor {
  color_min_value: uint;
  color_max_value: uint;
}

table EffectParticleElementInitColor {
  color_min_value: uint;
  color_max_value: uint;
}

table EffectParticleElementRotationTrans {
  rotation_factor: float;
  end_life_time_per: float;
}

table EffectParticleElementRotation {
  rotation_value: Vec2; // min, max
  rotation_add_value: Vec2; // min, max
}

table EffectParticleElementBasic {
  priority: int;
  maximum_particle: int;
  attime_create: int;
  interval: int;
  lifetime: int;
  speed_min_value: float;
  speed_max_value: float;
  lifespan_min_value: int;
  lifespan_max_value: int;
  angle: float;
  angle_variance: float;
}

union EffectNodeBehavior {
  EffectParticleElementBasic,
  EffectParticleElementRndSeedChange: IntValueEntry,
  EffectParticleElementDelay: IntValueEntry,
  EffectParticleElementGravity: Vec2ValueEntry,
  EffectParticleElementPosition: RectValueEntry,
  EffectParticleElementRotation,
  EffectParticleElementRotationTrans,
  EffectParticleElementTransSpeed: Vec2ValueEntry,
  EffectParticleElementTangentialAcceleration: Vec2ValueEntry,
  EffectParticleElementInitColor,
  EffectParticleElementTransColor,
  EffectParticleElementAlphaFade: Vec2ValueEntry,
  EffectParticleElementSize: RectAndVec2ValueTable,
  EffectParticleElementTransSize: RectAndVec2ValueTable,
  EffectParticlePointGravity,
  EffectParticleTurnToDirectionEnabled: FloatValueEntry,
  EffectParticleInfiniteEmitEnabled: IntValueEntry,
}

table EffectNodeBehaviorWrapper {
  value: EffectNodeBehavior;
}

table EffectNode {
  index: short;
  parent_index: short;
  effect_node_type: EffectNodeType;
  cell_name_hash: uint32;
  cell_map_name_hash: uint32;
  blend_type: RenderBlendType;
  behavior: [EffectNodeBehaviorWrapper];
}

table Effect {
  name_hash: uint32 (key);
  name: string;
  fps: short;
  is_lock_rand_seed: bool;
  lock_rand_seed: short;
  layout_scale: Vec2;
  effect_node: [EffectNode];
}

table SoundFile {
  name_hash: uint32 (key);
  name: string;
  file_path: string;
  file_path_hash: uint32; // fnv1a(file_path); used as embedded_assets key when embedded
  time_total: uint;
}

table SoundList {
  name_hash: uint32 (key);
  name: string;
  table_data:[SoundFile];
}

table FontGlyphBitmap {
  id: ushort (key);
  atlas: Rect;
  offset: Vec2;
  width_advance: float;
  text: string;
  page: byte;
  channel: byte;
}

table FontBitmap {
  name_hash: uint32 (key);
  name: string;

  name_face: string;
  size: ushort;
  padding_l: ushort;
  padding_r: ushort;
  padding_u: ushort;
  padding_d: ushort;
  base: short;
  height_line: short;
  scale: Vec2;
  spacing: Vec2;
  size_texture_original: Vec2;

  name_texture: [string];
  name_texture_hash: [uint32]; // fnv1a(name_texture[i]); used as embedded_assets key when embedded
  table_data: [FontGlyphBitmap];
}

table PartMeshBinding {
  vertex_influence_offset: [uint32];
  influence_bone:          [ushort];
  influence_weight:        [float];
  influence_coord_x:       [float];
  influence_coord_y:       [float];
}

table PartAttributeCell {
 cellmap_name_hash: uint32; // fnv1a(cellmap name without .ssce)
 name_hash: uint32; // fnv1a(cell name)
}

table  SsAttributePartColorKeyValueColor {
  rgba: U8Rect;
  rate: float;
}

table PartAttributePartColor {
  blend_type: BlendType;

  lt: SsAttributePartColorKeyValueColor;
  rt: SsAttributePartColorKeyValueColor;
  lb: SsAttributePartColorKeyValueColor;
  rb: SsAttributePartColorKeyValueColor;
}

table PartAttributeVertex {
  lt: Vec2;
  rt: Vec2;
  lb: Vec2;
  rb: Vec2;
}
table PartAttributeInstance {
  pingpong: bool;
  independent: bool;
  loop_num: int;
  start_label_hash: uint32;
  start_offset: int;
  end_label_hash: uint32;
  end_offset: int;
  speed: float;
  reverse: bool;
}

table PartAttributeEffect {
  start_time: int;
  speed: float;
  independent: bool;
}

table PartAttributeDeform {
  coord_x: [float];
  coord_y: [float];
  index: [short];
}

table PartAttributeShader {
  id: string;
  id_hash: uint32;
  param0: float;
  param1: float;
  param2: float;
  param3: float;
  param4: float;
  param5: float;
  param6: float;
  param7: float;
  map0_cellmap_name_hash: uint32; // fnv1a(cellmap name without .ssce)
  map0_name_hash: uint32;
  map1_cellmap_name_hash: uint32; // fnv1a(cellmap name without .ssce)
  map1_name_hash: uint32;
}

table PartAttributeUserData {
  integer: IntValueEntry;
  rect: Rect;
  point: Vec2;
  str: string;
}

enum SignalCommandParamType: ubyte {
  Bool,
  Index,
  Integer,
  Floating,
  Text,
  None,
}

union SignalCommandParamValue {
  Bool: BoolValueEntry,
  Index: IntValueEntry,
  Integer: IntValueEntry,
  Floating: FloatValueEntry,
  Text: StringValueEntry,
  None: NoneValueEntry,
}

table SignalCommandParam {
  param_id: string;
  type: SignalCommandParamType;
  value: SignalCommandParamValue;
}

table PartAttributeSignal {
  active: bool;
  command_id: string;
  params: [SignalCommandParam];
}

table PartAttributeAudio {
  sound_list_name_hash: uint32; // fnv1a(SoundList.name) — addresses SoundList
  sound_name_hash: uint32;      // fnv1a(alias) — addresses SoundFile within the SoundList
  sound_name: string;           // alias (kept for diagnostics)
  loop_num: int;
}

enum PartAttributesUpdateFlags: ulong (bit_flags) {
  AttributeCell,
  AttributePosX,
  AttributePosY,
  AttributePosZ,
  AttributeRotX,
  AttributeRotY,
  AttributeRotZ,
  AttributeSclX,
  AttributeSclY,
  AttributeLosclX,
  AttributeLosclY,
  AttributeAlpha,
  AttributeLoAlpha,
  AttributePrio,
  AttributeFlipH,
  AttributeFlipV,
  AttributeHide,
  AttributePartColor,
  AttributeShader,
  AttributeVertex,
  AttributePivotX,
  AttributePivotY,
  AttributeAnchorX,
  AttributeAnchorY,
  AttributeSizeX,
  AttributeSizeY,
  AttributeImgFlipH,
  AttributeImgFlipV,
  AttributeUvtX,
  AttributeUvtY,
  AttributeUvrZ,
  AttributeUvsX,
  AttributeUvsY,
  AttributeBoundr,
  AttributeMask,
  AttributeSkew,
  AttributeDeform,
  AttributeTexture,
//  AttributeUserData,    // Reserved
//  AttributeSignal,      // Reserved
//  AttributeAudio,       // Reserved
//  AttributeInstance,    // Reserved
//  AttributeEffect,      // Reserved
}

table InitialPartAttributes {
  update_flag: PartAttributesUpdateFlags = 0;

  cell: PartAttributeCell;
  position_x: float = 0.0;
  position_y: float = 0.0;
  position_z: float = 0.0;
  rotation_x: float = 0.0;
  rotation_y: float = 0.0;
  rotation_z: float = 0.0;
  scale_x: float = 1.0;
  scale_y: float = 1.0;
  local_scale_x: float = 1.0;
  local_scale_y: float = 1.0;
  alpha: float = 1.0;
  local_alpha: float = 1.0;
  priority: float = 0.0;
  flip_h: bool = false;
  flip_v: bool = false;
  hide: bool = false;
  part_color: PartAttributePartColor;
  shader: PartAttributeShader;
  vertex: PartAttributeVertex;
  pivot_x: float = 0.0;
  pivot_y: float = 0.0;
  anchor_x: float = 0.0;
  anchor_y: float = 0.0;
  size_x: float = 1.0;
  size_y: float = 1.0;
  img_flip_h: bool = false;
  img_flip_v: bool = false;
  uv_translation_x: float = 0.0;
  uv_translation_y: float = 0.0;
  uv_rotation_z: float = 0.0;
  uv_scale_x: float = 1.0;
  uv_scale_y: float = 1.0;
  bounding_radius: float = 0.0;
  mask: float = 0.0;
  skew_x: float = 0.0;
  skew_y: float = 0.0;
  deform: PartAttributeDeform;

  texture: uint32 = 0;
}

table InitialEvents {
  user: PartAttributeUserData;
  signal: PartAttributeSignal;
  audio: PartAttributeAudio;
  instance: PartAttributeInstance;
  effect: PartAttributeEffect;
}

enum ShapeType: ubyte {
  Unknown,
  Triangle,
  Rectangle,
  Arrow,
  Star,
}

table PartTypeShape {
  shape_type: ShapeType;
  shape_mask: bool;
}

enum TextAnchor: ubyte {
  NO = 0xFF,

  LT = 0x00,
  LC = 0x01,
  LB = 0x02,
  CT = 0x10,
  CC = 0x11,
  CB = 0x12,
  RT = 0x20,
  RC = 0x21,
  RB = 0x22,
}

table PartTypeText {
  text: string;
  text_bitmap: bool;
  text_family: string;
  text_char_map: string;
  text_size: int;
  text_space: float;
  text_smooth: bool;
  text_mask: bool;
  text_width: int;
  text_height: int;
  e_anchor: TextAnchor;
}

table PartTypeNines {
  nines_margin_l: int;
  nines_margin_r: int;
  nines_margin_t: int;
  nines_margin_b: int;
  nines_fill_mode: int;
  nines_mask: bool;
}

table PartTypeInstance {
  ref_anime_pack_and_name_hash: uint32;
  ref_anime_pack: string;
  ref_anime_pack_hash: uint32;
  ref_anime_name: string;
  ref_anime_name_hash: uint32;
}

table PartTypeEffect {
  ref_effect_name_hash: uint32;
}

union PartType {
  PartTypeNull: NoneValueEntry,
  PartTypeNormal: NoneValueEntry,
  PartTypeShape,
  PartTypeText,
  PartTypeNines,
  PartTypeInstance,
  PartTypeArmature: NoneValueEntry,
  PartTypeEffect,
  PartTypeMesh: NoneValueEntry,
  PartTypeMovenode: NoneValueEntry,
  PartTypeConstraint: NoneValueEntry,
  PartTypeMask: NoneValueEntry,
  PartTypeJoint: NoneValueEntry,
  PartTypeBonepoint: NoneValueEntry,
  PartTypeTransformConstraint: NoneValueEntry,
  PartTypeCamera: NoneValueEntry,
  PartTypeAudio: NoneValueEntry,
}

table PartData {
  name: string;
  parent_index: short;
  bounds_type: BoundsType;
  blend_type: BlendType;
  visible_inside_mask: bool;
  mask_write: bool;
  mask_influence: bool;
  output_influence: bool = true;
  mesh_binding: PartMeshBinding;

  part_type: PartType;
}

table Label {
  name_hash: uint32 (key);
  name: string;
  time: int;
}

table PartAnimationDataCellValue {
  index: ushort (key);

  value: PartAttributeCell;
}

table PartAnimationDataFloatValue {
  index: ushort (key);
  interpolation: InterpolationType = None;

  value: float;

  curve: SsCurve;
  easing_rate: float = 0;
}

table PartAnimationDataIntValue {
  index: ushort (key);
  interpolation: InterpolationType = None;

  value: int;

  curve: SsCurve;
  easing_rate: float = 0;
}

table PartAnimationDataUIntValue {
  index: ushort (key);
  interpolation: InterpolationType = None;

  value: uint32;
}

table PartAnimationDataBoolValue {
  index: ushort (key);

  value: bool;
}

table PartAnimationDataPartColor {
  index: ushort (key);
  interpolation: InterpolationType = None;

  value: PartAttributePartColor;

  curve: SsCurve;
  easing_rate: float = 0;
}

table PartAnimationDataShader {
  index: ushort (key);
  interpolation: InterpolationType = None;

  value: PartAttributeShader;

  curve: SsCurve;
  easing_rate: float = 0;
}

table PartAnimationDataVertex {
  index: ushort (key);
  interpolation: InterpolationType = None;

  value: PartAttributeVertex;

  curve: SsCurve;
  easing_rate: float = 0;
}

table PartAnimationDataInstance {
  index: ushort (key);

  value: PartAttributeInstance;
}

table PartAnimationDataEffect {
  index: ushort (key);

  value: PartAttributeEffect;
}

table PartAnimationDataVec2 {
  index: ushort (key);
  interpolation: InterpolationType = None;

  value: Vec2;

  curve: SsCurve;
  easing_rate: float = 0;
}

table PartAnimationDataDeform {
  index: ushort (key);
  interpolation: InterpolationType = None;

  value: PartAttributeDeform;

  curve: SsCurve;
  easing_rate: float = 0;
}

table PartAnimationData {
  cell_array: [PartAnimationDataCellValue];
  position_x_array: [PartAnimationDataFloatValue];
  position_y_array: [PartAnimationDataFloatValue];
  position_z_array: [PartAnimationDataFloatValue];
  rotation_x_array: [PartAnimationDataFloatValue];
  rotation_y_array: [PartAnimationDataFloatValue];
  rotation_z_array: [PartAnimationDataFloatValue];
  scale_x_array: [PartAnimationDataFloatValue];
  scale_y_array: [PartAnimationDataFloatValue];
  local_scale_x_array: [PartAnimationDataFloatValue];
  local_scale_y_array: [PartAnimationDataFloatValue];
  alpha_array: [PartAnimationDataFloatValue];
  local_alpha_array: [PartAnimationDataFloatValue];
  priority_array: [PartAnimationDataIntValue];
  flip_h_array: [PartAnimationDataBoolValue];
  flip_v_array: [PartAnimationDataBoolValue];
  hide_array: [PartAnimationDataBoolValue];
  part_color_array: [PartAnimationDataPartColor];
  shader_array: [PartAnimationDataShader];
  vertex_array: [PartAnimationDataVertex];
  pivot_x_array: [PartAnimationDataFloatValue];
  pivot_y_array: [PartAnimationDataFloatValue];
  anchor_x_array: [PartAnimationDataFloatValue];
  anchor_y_array: [PartAnimationDataFloatValue];
  size_x_array: [PartAnimationDataFloatValue];
  size_y_array: [PartAnimationDataFloatValue];
  img_flip_h_array: [PartAnimationDataBoolValue];
  img_flip_v_array: [PartAnimationDataBoolValue];
  uv_translation_x_array: [PartAnimationDataFloatValue];
  uv_translation_y_array: [PartAnimationDataFloatValue];
  uv_rotation_z_array: [PartAnimationDataFloatValue];
  uv_scale_x_array: [PartAnimationDataFloatValue];
  uv_scale_y_array: [PartAnimationDataFloatValue];
  bounding_radius_array: [PartAnimationDataFloatValue];
  mask_array: [PartAnimationDataFloatValue];
  skew_array: [PartAnimationDataVec2];
  deform_array: [PartAnimationDataDeform];
  texture_array: [PartAnimationDataUIntValue];
}

table AnimationData {
  name: string (required);
  name_hash: uint32;

  parts_initial_attributes: [InitialPartAttributes];
  parts_animation_data: [PartAnimationData];

  events: [EventsPerFrame];
  initial_events: [InitialEvents];

  labels: [Label];

  start_frame: short;
  end_frame: short;
  total_frame: short;
  fps: short;

  canvas: Rect;
}

table ExternalTexture {
  name_hash: uint32 (key);
  name: string;
}

table ExternalInstance {
  anime_pack_and_name_hash: uint32 (key);
  anime_pack_name: string;
  anime_name: string;
}

table EmbeddedAsset {
  name_hash: uint32 (key);
  name: string;

  data: [ubyte];
}

table SsAnimeBinary {
  version: uint = 0x00000001;

  name: string;
  name_hash: uint32;

  parts: [PartData];
  animations: [AnimationData];

  cellmaps: [CellMap];
  effects: [Effect];
  sound_lists: [SoundList];
  font_bitmaps: [FontBitmap];

  external_textures: [ExternalTexture];
  external_instances: [ExternalInstance];

  embedded_assets: [EmbeddedAsset];
}

file_identifier "SSAB";
file_extension "ssab";
root_type SsAnimeBinary;
