namespace ss.format;

enum SequenceType: ubyte {
  Last,
  Keep,
  Top,
}

table SequenceItem {
  ref_anime_pack: string (required);
  ref_anime_pack_hash: uint32;
  ref_anime_name: string (required);
  ref_anime_name_hash: uint32;
  repeat_count: int;
}

table Sequence {
  name: string (key, required);
  name_hash: uint32;
  index: int;
  type: SequenceType;
  list: [SequenceItem];
}

table SsSequenceBinary {
  version: uint = 0x00000001;

  sequence_list: [Sequence] (required);
}

file_identifier "SSQB";
file_extension "ssqb";
root_type SsSequenceBinary;
