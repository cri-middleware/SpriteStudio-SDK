# http://editorconfig.org
root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Rust 関連
[*.rs]
indent_size = 4

# XML 関連 (SpriteStudio のプロジェクトファイルは 2 スペースが一般的です)
[*.{sspj,ssae,ssce,ssee,ssqe,ssse,xml}]
indent_size = 2

# 設定ファイル・Web 関連
[*.{yml,yaml,json,html,css,js,ts}]
indent_size = 2

# Shell / Batch スクリプト
[*.{sh,bash}]
indent_size = 2

[*.{ps1,bat}]
indent_size = 4

# FlatBuffers 関連
[*.fbs]
indent_size = 4

# Markdown (末尾のスペースに意味がある場合があるためトリミングしない)
[*.md]
trim_trailing_whitespace = false
