    table_label:[Label];
    table_parts:[DataAnimationParts];
}

enum UserDataFlagBit:uint {
    CLEAR = 0x00000000,
    NUMBER = 0x00000001,
    RECTANGLE = 0x00000002,
    COORDINATE = 0x00000004,
    TEXT = 0x00000008,

    VALID = 0x40000000,
}

table UserData {
    flags:UserDataFlagBit;
    number_int:int;
    rectangle:Rect;
    coordinate:Vector2;
    text:string;
}

enum DataSetupFlagUse0:uint {
    CLEAR                 = 0x00000000,

    HAS_STATUS            = 0x00000001,
    HAS_CELL              = 0x00000002,
    HAS_POSITION_X        = 0x00000004,
    HAS_POSITION_Y        = 0x00000008,
    HAS_POSITION_Z        = 0x00000010,
    HAS_ROTATION_X        = 0x00000020,
    HAS_ROTATION_Y        = 0x00000040,
    HAS_ROTATION_Z        = 0x00000080,
    HAS_SCALING_X         = 0x00000100,
    HAS_SCALING_Y         = 0x00000200,
    HAS_SCALINGLOCAL_X    = 0x00000400,
    HAS_SCALINGLOCAL_Y    = 0x00000800,
    HAS_RATEOPACITY       = 0x00001000,
    HAS_RATEOPACITYLOCAL  = 0x00002000,
    HAS_POWERMASK         = 0x00004000,
    HAS_PRIORITY          = 0x00008000,
    HAS_PARTSCOLOR        = 0x00010000,
    HAS_VERTEXCORRECTION  = 0x00020000,
    HAS_SKEW              = 0x00040000,
    HAS_OFFSETPIVOT_X     = 0x00080000,
    HAS_OFFSETPIVOT_Y     = 0x00100000,
    HAS_POSITIONANCHOR_X  = 0x00200000,
    HAS_POSITIONANCHOR_Y  = 0x00400000,
    HAS_SIZEFORCE_X       = 0x00800000,
    HAS_SIZEFORCE_Y       = 0x01000000,
    HAS_POSITIONTEXTURE_X = 0x02000000,
    HAS_POSITIONTEXTURE_Y = 0x04000000,
    HAS_ROTATIONTEXTURE   = 0x08000000,
}

enum DataSetupFlagUse1:uint {
    CLEAR                 = 0x00000000,

    HAS_SCALINGTEXTURE_X  = 0x00000001,
    HAS_SCALINGTEXTURE_Y  = 0x00000002,
    HAS_RADIUSCOLLISION   = 0x00000004,
    HAS_USERDATA          = 0x00000008,
    HAS_INSTANCE          = 0x00000010,
    HAS_EFFECT            = 0x00000020,
    HAS_DEFORM            = 0x00000040,
    HAS_SHADER            = 0x00000080,
    HAS_SIGNAL            = 0x00000100,
    HAS_AUDIO             = 0x00000200,
    HAS_CHANGETEXTURE     = 0x00000400,
}

table DataSetup {
	flag_use0:DataSetupFlagUse0;
	flag_use1:DataSetupFlagUse1;

    status:int;
    cell:AnimationAttributeCell;
    position_x:float;
    position_y:float;
    position_z:float;
    rotation_x:float;
    rotation_y:float;
    rotation_z:float;
    scaling_x:float;
    scaling_y:float;
    scalinglocal_x:float;
    scalinglocal_y:float;
    rateopacity:float;
    rateopacitylocal:float;
    powermask:float;
    priority:int;
    partscolor:AnimationAttributePartsColor;
    vertexcorrection:VertexCorrection;
    skew:AttributeSkew;
    offsetpivot_x:float;
    offsetpivot_y:float;
    position_anchor_x:float;
    position_anchor_y:float;
    size_force_x:float;
    size_force_y:float;
    position_texture_x:float;
    position_texture_y:float;
    rotation_texture:float;
    scaling_texture_x:float;
    scaling_texture_y:float;
    radius_collision:float;
    user_data:UserData;
    instance:AnimationAttributeInstance;
    effect:AnimationAttributeEffect;
    deform:AnimationAttributeDeform;
    deform_tableindex:[int];
    deform_countvertex:int;
    shader:AnimationAttributeShader;
    signal:AnimationAttributeSignal;
    audio:AnimationAttributeAudio;
    change_texture:AnimationAttributeChangeTexture;
}

enum DataEffectFlagBit:uint {
    Clear = 0x00000000,

    SeedRandomLock = 0x00000001,
}

enum DataEffectPartsKindFeature:ubyte {
    Root = 0,
    Emitter,
    Particle,

    Terminator,
}

table DataEffectParts {
    name:string;

    id:ushort;
    id_parent:ushort;
    table_id_child:[int];

//    feature:DataEffectPartsKindFeature;
    feature:ushort;
    index_emitter:ushort;
}

enum DataEffectEmitterFlagBit:uint {
    Clear = 0x00000000,

    Basic = 0x00000001,	/* (Reserved) */
    TangentialAccelation = 0x00000002,
    TurnDirection = 0x00000004,
    SeedRandom = 0x00000008,
    Delay = 0x00000010,

    Position = 0x00000100,
    PositionFluctuation = 0x00000200,	/* (Reserved) */
    Rotation = 0x00000400,
    RotationFluctuation = 0x00000800,
    ScaleStart = 0x00001000,
    ScaleEnd = 0x00002000,

    Speed = 0x00010000,	/* (Reserved) */
    SpeedFluctuation = 0x00020000,
    GravityDirection = 0x00040000,
    GravityPoint = 0x00080000,

    ColorVertex = 0x00100000,
    ColorVertexFluctuation = 0x00200000,
    FadeAlpha = 0x00400000,

    EmitInfinite = 0x01000000,

    MaskEmitter = 0x7f000000,
    MaskParticle = 0x00ffffff,
    MaskValid = 0x7fffffff,
}

table DataEffectEmitter {
//    flag_data:DataEffectEmitterFlagBit;
    flag_data:uint;

//    operation_blend_target:KindOperationBlendEffect;
    operation_blend_target:uint;

    index_cell_map:ushort;
    index_cell:ushort;

    angle:RangeFloat;

    gravity_directional:Vector2;
    gravity_point_position:Vector2;
    gravity_point_power:float;

    position:RangeVector2;

    rotation:RangeFloat;
    rotation_fluctuation:RangeFloat;
    rotation_fluctuation_rate:float;
    rotation_fluctuation_rate_time:float;

    rate_tangential_acceleration:RangeFloat;

    scale_start:RangeVector2;
    scale_rate_start:RangeFloat;

    scale_end:RangeVector2;
    scale_rate_end:RangeFloat;

    delay:int;

    color_vertex:RangeColor;
    color_vertex_fluctuation:RangeColor;

    alpha_fade_start:float;
    alpha_fade_end:float;

    speed:RangeFloat;
    speed_fluctuation:RangeFloat;

    turn_direction_fluctuation:float;

    seed_random:long;

    duration_emitter:int;
    interval:int;
    duration_particle:RangeFloat;

    count_particle_max:int;
    count_particle_emit:int;

    count_parts_maximum:int;
    table_pattern_emit:[PatternEmit];
    table_pattern_offset:[int];
    table_seed_particle:[long];
}


table DataSequenceDetails {
	refAnimePack:string;
	refAnime:string;
	repeatCount:int;
}

table DataSequence {
    name:string;
    index:int;
    type:int;
    valueList:[DataSequenceDetails];
}


