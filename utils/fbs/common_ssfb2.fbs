{
	TableCode:[int];
}


table ContainerStatus
{
	TypePack:KindTypePack;
	TableCodeValue:[CodeValueContainer];
	TableValue:[int];
	TableAccessory:[float];
}

table ContainerCell
{
	TypePack:KindTypePack;
