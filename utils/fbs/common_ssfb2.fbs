}


table LibraryDataAnimation {
    name:string;
    frame_per_second:int;
    count_frame:int;

    size_canvas_x:int;
    size_canvas_y:int;

    frame_valid_start:int;
    frame_valid_end:int;
    count_frame_valid:int;

    depth_ik:int;
