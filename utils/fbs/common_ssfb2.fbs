namespace ss.ssfb2;

enum KindDataFile:ubyte {
    Project = 0x00,
    CellMap = 0x01,
    Animation = 0x02,
    Effect = 0x03,
    Sequence = 0x04,
    Sound = 0x05,
    FontBitmap = 0x06,
    /* Max : 0x0f */
}

enum DataVersionPropertyFlagBitStatus:ubyte {		// Ver.3.0 -
    Clear = 0x00,

    MaskKindData = 0x0f,	// Bit-Mask & Value-Invalid for KindDataFile

	DependentKind01 = 0x10,
	DependentKind02 = 0x20,
	DependentKind03 = 0x40,
    SplitProject = 0x80,
}

table DataVersion {		// Ver.3.0 -
    property:ubyte;		// DataVersionPropertyFlagBitStatus
    major:ubyte;
    minor:ubyte;
    revision:ubyte;
}

enum DataExtendInformationFileFlagBitStatus:ushort {		// Ver.3.0 -
    Clear = 0x0000,

    UsedFromData = 0x0001,

    IsData = 0x4000,
//  (Don't use) = 0x8000,
}

table DataExtendInformationFile {	// Ver.3.0 -
    status:ushort;	// DataExtendInformationFileFlagBitStatus
    name:string;
}

table Vector2 {
    x:float;
    y:float;
}

table Vector3 {
    x:float;
    y:float;
    z:float;
}

table Rect {
    x_min:float;
    y_min:float;
    x_max:float;
    y_max:float;
}

table DataMesh {
    table_coordinate:[Vector2];
    table_index_vertex:[ushort];
}

table Cell {
    name:string;
    rectangle:Rect;
    pivot:Vector2;
    rotate:float;			// Ver.3.0 -
    size_untrimmed:Vector2;	// Ver.3.0 -
    mesh:DataMesh;
}

enum LibraryDataCellMapFlagBitStatus:ushort {		// Ver.3.0 -
    Clear = 0x0000,

    TextureConvertPMA = 0x0001,
	BlendImagePMA = 0x0002,
	CorrectShaderPMA = 0x0004,

//  (Don't use) = 0x8000,
}

table LibraryDataCellMap {
    name:string;
    size_original:Vector2;
    filter:short;
    wrap:short;
	status:LibraryDataCellMapFlagBitStatus;
    table_cell:[Cell];
}

enum DataModelPartsKindFeature:ubyte {
    Root = 0,	/* Root-Parts (Subspecies of "NULL"-Parts) */
    Null,
    Normal,

    Instance,
    Effect,

    Mask,

    Joint,
    Bone,
    MoveNode,
    Constraint,
    BonePoint,
    Mesh,

	Transform_Constraint,
	Camera,

	Audio,
	Shape,
	Text,
	Nine_Slice,

    Terminator,
}

enum KindVertex:int {		// Ver.3.0 -
    /* MEMO: CW (Clockwise) sequence. */
    LU = 0,
    RU,
    RD,
    LD,
    C,					// Muust be the last numbered. (Used only Runtime)

	// MEMO: Follows are used only Runtime. (Labels to identify length of arrays and count of "for"-loops)
    TERMINATOR,

// MEMO: ↓の定義は存在するとC#などでは大丈夫なのだが、C++の名称テーブルの定義でエラーが出るのでC#/C++側で追加定義します。
//    TERMINATOR4 = 5,	// = TERMINATOR, /* for "Normal(Sprite)" */
//    TERMINATOR3 = 3,	// = LD == C - 1, /* for "Mesh" */
//    TERMINATOR2 = 4,	// = C /* for "Effect" */
}

enum KindCollision:ubyte {
    Non = 0,
    Square,
    Aabb,
    Circle,
    CircleScaleMinimum,
    CircleScaleMaximum,
}

enum KindShape:byte {
	Non = -1,
    Rectangle = 0,
}

enum KindAnchorText:byte {
    NON = -1,
    LU = 0,
    CU = 1,
    RU = 2,
    _RESERVE_U = 3,
    LC = 4,
    CC = 5,
    RC = 6,
    _RESERVE_C = 7,
    LD = 8,
    CD = 9,
    RD = 10,
    _RESERVE_D = 11,
}

table Bone {
    index:ushort;
    weight:float;
    coordinate_offset:Vector3;
}

table Vertex {
    table_bone:[Bone];
}

table BindMesh {
    count_vertex:int;
    table_vertex:[Vertex];
    table_rate_uv:[Vector2];
    table_index_vertex:[uint16];

    count_vertex_deform:int;
}

enum ColorLabelKindForm:ubyte {
    Non = 0,

    Red,
    Orange,
    Yellow,
    Green,
    Blue,
    Violet,
    Gray,

    Terminator,
    // Custom = Terminator 代入できない
}

table Color32 {
    r:ubyte;
    g:ubyte;
    b:ubyte;
    a:ubyte;
}

table Color {
    r:float;
    g:float;
    b:float;
    a:float;   
}

table ColorLabel {
    form:ColorLabelKindForm;
    color:Color32;
}

enum KindOperationBlend:byte {
    // TERMINATOR_TABLEMATERIAL = TERMINATOR - INITIATOR,	/* - (-x) = +(x) */
    // TERMINATOR_PARTSCOLOR = MUL_NA,
    // INITIATOR = MASK_PRE,

    MaskPre = -2,
    Mask = -1,
    // Non = -1, TODO: 同じ値はできなさそう

    Mix = 0,
    Add,
    Sub,
    Mul,

    MulNa,
    Scr,
    Exc,
    Inv,

    Terminator,
}

table Catalog {
    table_id_parts_null:[ushort];
    table_id_parts_normal:[ushort];
    table_id_parts_instance:[ushort];
    table_id_parts_effect:[ushort];
    table_id_parts_mask:[ushort];
    table_id_parts_joint:[ushort];
    table_id_parts_bone:[ushort];
    table_id_parts_move_node:[ushort];
    table_id_parts_constraint:[ushort];
    table_id_parts_bone_point:[ushort];
    table_id_parts_mesh:[ushort];
    table_id_parts_transform_constraint:[ushort];
    table_id_parts_camera:[ushort];
    table_id_parts_audio:[ushort];
    table_id_parts_shape:[ushort];
    table_id_parts_text:[ushort];
    table_id_parts_nine_slice:[ushort];
}

table DataModelParts {
    name:string;
    id:int;
    id_parent:int;
    table_id_children:[int];

    feature:DataModelPartsKindFeature;

    count_mesh:int;
    mesh:BindMesh;

    label_color:ColorLabel;

    operation_blend_target:KindOperationBlend;

    shape_collision:KindCollision;
    size_collision:float;

    index_animation_pack_under_control:ushort;
    index_effect_under_control:ushort;
    name_animation_under_control:string;

    size_font_text:float;
    space_text:float;
    size_x_text:int;
    size_y_text:int;
    name_family_font_text:string;
    index_bitmap_font_text:int;
    text:string;
    anchor_text:KindAnchorText;

    shape:KindShape;

	margin_l_nineslice:int;
	margin_r_nineslice:int;
	margin_u_nineslice:int;
	margin_d_nineslice:int;

    status:int;
}

enum KindModeSort:ubyte {
    Priority = 0,
    PositionZ,
}

table Label {
    name:string;
    frame:ushort;
}

enum DataAnimationPartsFlagBitStatus:uint {
    Clear = 0x00000000,

	NoSignal = 0x00008000,

    NoEffect = 0x00010000,
    NoInstance = 0x00020000,
    NoPartsColor = 0x00040000,
    NoUserData = 0x00080000,

    NoTransformationTexture = 0x00100000,
    NoScaling = 0x00200000,
    NoRotation = 0x00400000,
    NoPosition = 0x00800000,

    NotMasking = 0x08000000,
    ModeSkew = 0x01000000,

    HideFull = 0x10000000,
    NotUsed = 0x20000000,
    Valid = 0x40000000,
}

enum KindOperationBlendEffect:byte {
    // TERMINATOR_TABLEMATERIAL = TERMINATOR - INITIATOR,	/* - (-x) = +(x) */
    // Initiator = MIX,

    Non = -1,
    Mix = 0,
    Add,
    Terminator,
}

table RangeFloat {
    main:float;
    sub:float;
}

table RangeVector2 {
    main:Vector2;
    sub:Vector2;
}

table RangeColor {
    main:Color;
    sub:Color;
}

table PatternEmit {
    index_generate:int;
    duration:int;
    cycle:int;
}

enum KindTypePack:short
{
	STANDARD_UNCOMPRESSED = 0,	/* Standard-Uncompressed (Plain Array) */
	STANDARD_CPE,	/* Standard-Compressed (Changing-Point Extracting) */
	CPE_FLYWEIGHT,	/* CPE & GoF-Flyweight (Commonized CPE's dictionary) */
	CPE_INTERPOLATE,	/* CPE & Interpolate (Linear,Acceleration and Deceleration: Interpolate / Other: CPE) */

	TERMINATOR,
}


