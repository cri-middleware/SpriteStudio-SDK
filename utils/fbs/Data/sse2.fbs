include "common_ssfb2.fbs";

namespace ss.ssfb2;

table DataEffectExtendSplit {	// Ver.3.0 -
	name_project:string;
	cellmap_project:[DataExtendInformationFile];
}

table DataEffectSplit {		// Ver.3.0 -
    version:DataVersion;
    name:string;
//    flag_data:DataEffectFlagBit;
    flag_data:int;

    seed_random:int;
    version_renderer:int;

    count_max_particle:int;
    count_frame_per_second:int;

    scale_layout:Vector2;

    table_parts:[DataEffectParts];
    table_emitter:[DataEffectEmitter];
    table_index_emitter_order_draw:[int];

    extend_split:DataEffectExtendSplit;		// Ver.3.0 -
}


// Split-Format : Effect
file_identifier "SSE2";
root_type DataEffectSplit;

